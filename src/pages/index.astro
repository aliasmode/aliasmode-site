---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
---
<BaseLayout
  title="Free Open-Source Antidetect Browser"
  description="AliasMode is a free, open-source antidetect browser for managing multiple accounts. Create unlimited profiles, sync across devices, and work with your team."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Free &amp; open source · Windows beta</p>
      <h1>The free, open-source <span>antidetect browser</span> for managing multiple accounts.</h1>
      <p class="lead">Create unlimited isolated browser profiles, sync them across your devices, and collaborate with your team from one workspace.</p>
      <div class="actions">
        <a class="button" href="/download">Download &amp; sign up free</a>
        <a class="button secondary" href="https://github.com/aliasmode/aliasmode">View source</a>
      </div>
      <p class="hero-note"><a href="/local-vs-cloud">Prefer no account? Use Local mode.</a></p>
    </div>

    <div class="workspace" role="img" aria-label="AliasMode workspace with separate synchronized browser profiles">
      <div class="window-bar"><span></span><span></span><span></span><b>AliasMode</b></div>
      <div class="workspace-body">
        <aside>
          <div class="mini-brand"><svg viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#31B8C7" stroke-width="64" stroke-linecap="round"/></svg><strong>Profiles</strong></div>
          <span class="nav-active">All profiles <b>∞</b></span>
          <span>Workspace</span>
          <span>Team</span>
        </aside>
        <div class="profile-board">
          <div class="board-head"><div><small>Your workspace</small><strong>Browser profiles</strong></div><button type="button" tabindex="-1">+ New profile</button></div>
          <div class="profile-row"><span class="profile-icon cobalt">A</span><div><strong>Agency workspace</strong><small>Cloud profile</small></div><span class="status">Synced</span><span class="dots">•••</span></div>
          <div class="profile-row"><span class="profile-icon cyan">S</span><div><strong>Storefront</strong><small>Cloud profile</small></div><span class="status">Synced</span><span class="dots">•••</span></div>
          <div class="profile-row"><span class="profile-icon navy">C</span><div><strong>Client account</strong><small>Cloud profile</small></div><span class="status active">Open</span><span class="dots">•••</span></div>
          <div class="team-row"><span>Workspace members</span><div class="avatars"><i>AM</i><i>JD</i><i>+2</i></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-row" aria-label="Product highlights">
    <div><strong>Free</strong><span>No profile fees</span></div>
    <div><strong>Open source</strong><span>Built in public</span></div>
    <div><strong>Unlimited</strong><span>Browser profiles</span></div>
    <div><strong>Cloud ready</strong><span>Sync and teams</span></div>
  </section>

  <section class="section-intro" id="features">
    <p class="eyebrow">One browser. Every account.</p>
    <h2>Manage more accounts without paying more.</h2>
    <p class="lead">Give every account its own browser identity, then keep your work organized across devices and teammates.</p>
  </section>

  <div class="feature-grid">
    <article class="feature-card">
      <span class="feature-number">01</span>
      <h3>Unlimited profiles</h3>
      <p>Create a separate profile for every account, client, brand, or project. Add as many as your work needs.</p>
    </article>
    <article class="feature-card featured">
      <span class="feature-number">02</span>
      <h3>Isolated identities</h3>
      <p>Each profile keeps its own browser identity, cookies, sessions, and storage so your accounts stay separate.</p>
    </article>
    <article class="feature-card">
      <span class="feature-number">03</span>
      <h3>Cloud teamwork</h3>
      <p>Sync encrypted portable profiles, invite teammates, and work together through one shared workspace.</p>
    </article>
  </div>

  <section class="workflow-section">
    <div class="workflow-copy">
      <p class="eyebrow">Start in minutes</p>
      <h2>Download. Create. Sync. Share.</h2>
      <p>Install AliasMode on Windows and create your free Cloud account inside the app. Your profiles are ready when your work moves to another device or teammate.</p>
      <a class="text-link" href="/download">Get AliasMode free <span>→</span></a>
    </div>
    <ol class="workflow-steps">
      <li><span>1</span><div><strong>Download AliasMode</strong><small>Install the Windows beta.</small></div></li>
      <li><span>2</span><div><strong>Create your free account</strong><small>Choose Cloud inside the app.</small></div></li>
      <li><span>3</span><div><strong>Build your profiles</strong><small>Keep every account separate.</small></div></li>
      <li><span>4</span><div><strong>Sync or invite</strong><small>Move across devices or add your team.</small></div></li>
    </ol>
  </section>

  <section class="open-section">
    <div class="code-card" aria-hidden="true"><div class="code-top"><span></span><span></span><span></span></div><pre><code><b>aliasmode</b>/aliasmode

<span>★</span> free and open source
<span>✓</span> inspect the code
<span>↗</span> follow every release</code></pre></div>
    <div>
      <p class="eyebrow">Open by default</p>
      <h2>Built in the open.</h2>
      <p>Read the source, follow development, report issues, and contribute directly. AliasMode gives you a transparent alternative to closed multi-account browsers.</p>
      <a class="text-link" href="https://github.com/aliasmode/aliasmode">Explore AliasMode on GitHub <span>→</span></a>
    </div>
  </section>

  <section class="local-section">
    <div><p class="eyebrow">Local mode</p><h2>Want to work without an account?</h2></div>
    <div><p>Use AliasMode Local. Your profile data stays on that computer and AliasMode sends no traffic to Cloud.</p><a class="text-link" href="/local-vs-cloud">Compare Local and Cloud <span>→</span></a></div>
  </section>

  <section class="download-section">
    <DownloadPanel />
  </section>

  <section class="cta-band">
    <div><p class="eyebrow">Free standard plan</p><h2>Start managing multiple accounts for free.</h2><p>Unlimited profiles, Cloud sync, and team collaboration in one open-source browser.</p></div>
    <div class="cta-actions"><a class="button light" href="/download">Download &amp; sign up free</a><a href="/pricing">See free pricing</a></div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(30rem, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; min-height: 38rem; padding: 2rem 0 4.5rem; position: relative; }
  .hero::before { background-image: linear-gradient(#dbe6f5 1px, transparent 1px), linear-gradient(90deg, #dbe6f5 1px, transparent 1px); background-size: 3rem 3rem; content: ''; inset: -3rem calc(50% - 50vw) auto 52%; height: 35rem; mask-image: linear-gradient(to bottom, rgba(0,0,0,.7), transparent); opacity: .45; pointer-events: none; position: absolute; z-index: -1; }
  .hero h1 { font-size: clamp(3rem, 5.8vw, 5.7rem); max-width: 13ch; }
  .hero h1 span { color: #2457d6; }
  .hero-note { color: #526077; font-size: .88rem; margin: -.7rem 0 0; }
  .workspace { background: #111827; border: 1px solid #293447; border-radius: 1rem; box-shadow: 0 2.2rem 5rem rgba(21, 44, 79, .22); color: #dbe7f7; min-width: 0; overflow: hidden; transform: rotate(1deg); }
  .window-bar { align-items: center; border-bottom: 1px solid #293447; display: flex; gap: .4rem; height: 2.6rem; padding: 0 .8rem; }
  .window-bar span, .code-top span { background: #526174; border-radius: 50%; display: block; height: .48rem; width: .48rem; }
  .window-bar span:first-child, .code-top span:first-child { background: #31b8c7; }
  .window-bar b { color: #8fa0b6; font: 600 .68rem/1 ui-monospace, monospace; margin-left: auto; }
  .workspace-body { display: grid; grid-template-columns: 9rem 1fr; min-height: 25rem; }
  .workspace aside { border-right: 1px solid #293447; display: flex; flex-direction: column; gap: .5rem; padding: 1.2rem .8rem; }
  .workspace aside > span { border-radius: .4rem; color: #8fa0b6; display: flex; font-size: .7rem; justify-content: space-between; padding: .55rem; }
  .workspace aside .nav-active { background: #1d2b40; color: #fff; }
  .mini-brand { align-items: center; display: flex; gap: .45rem; margin-bottom: 1rem; }
  .mini-brand svg { height: 1.35rem; width: 1.35rem; }
  .mini-brand strong { color: #fff; font-size: .75rem; }
  .profile-board { background: #f4f7fb; color: #111827; padding: 1.3rem; }
  .board-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 1rem; }
  .board-head div { display: flex; flex-direction: column; }
  .board-head small { color: #6b7890; font-size: .58rem; text-transform: uppercase; }
  .board-head strong { font-size: 1rem; }
  .board-head button { background: #2457d6; border: 0; border-radius: .4rem; color: white; font-size: .63rem; padding: .52rem .65rem; }
  .profile-row { align-items: center; background: white; border: 1px solid #dce4ee; border-radius: .5rem; display: grid; gap: .7rem; grid-template-columns: auto 1fr auto auto; margin-top: .6rem; padding: .72rem; }
  .profile-row > div { display: flex; flex-direction: column; }
  .profile-row strong { font-size: .7rem; }
  .profile-row small { color: #7a879a; font-size: .56rem; }
  .profile-icon { align-items: center; border-radius: .35rem; color: white; display: flex; font-size: .65rem; font-style: normal; font-weight: 800; height: 1.8rem; justify-content: center; width: 1.8rem; }
  .cobalt { background: #2457d6; } .cyan { background: #168b9a; } .navy { background: #293447; }
  .status { background: #e4f7f0; border-radius: 2rem; color: #137257; font-size: .53rem; font-weight: 700; padding: .25rem .42rem; }
  .status.active { background: #e6edff; color: #2457d6; }
  .dots { color: #9ba7b8; font-size: .65rem; letter-spacing: .08rem; }
  .team-row { align-items: center; color: #65738a; display: flex; font-size: .58rem; justify-content: space-between; margin-top: 1.5rem; }
  .avatars { display: flex; }
  .avatars i { align-items: center; background: #dfe7f3; border: 2px solid #f4f7fb; border-radius: 50%; color: #35445c; display: flex; font-size: .42rem; font-style: normal; font-weight: 800; height: 1.6rem; justify-content: center; margin-left: -.3rem; width: 1.6rem; }
  .proof-row { background: #fff; border: 1px solid #dbe3ee; display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 7rem; }
  .proof-row div { display: flex; flex-direction: column; padding: 1.25rem 1.4rem; }
  .proof-row div + div { border-left: 1px solid #dbe3ee; }
  .proof-row strong { font-size: .9rem; }
  .proof-row span { color: #64748b; font-size: .7rem; }
  .section-intro { margin: 0 auto 2.5rem; text-align: center; }
  .section-intro h2 { font-size: clamp(2.2rem, 4vw, 3.7rem); margin-inline: auto; max-width: 18ch; }
  .section-intro p { margin-inline: auto; }
  .feature-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); margin-bottom: 7rem; }
  .feature-card { background: #fff; border: 1px solid #dbe3ee; min-height: 18rem; padding: 1.8rem; position: relative; }
  .feature-card.featured { background: #2457d6; border-color: #2457d6; color: white; transform: translateY(-1rem); }
  .feature-card h3 { font-size: 1.45rem; margin-top: 5rem; }
  .feature-card p { color: #526077; font-size: .92rem; }
  .feature-card.featured p { color: #dfe8ff; }
  .feature-number { color: #7891b5; font: 700 .72rem/1 ui-monospace, monospace; }
  .feature-card.featured .feature-number { color: #a9bdff; }
  .workflow-section { align-items: center; background: #111827; color: white; display: grid; gap: 4rem; grid-template-columns: .85fr 1.15fr; margin: 0 calc(50% - 50vw) 7rem; padding: 5rem max(1.5rem, calc((100vw - 69rem) / 2)); }
  .workflow-copy h2, .open-section h2, .local-section h2, .cta-band h2 { font-size: clamp(2rem, 4vw, 3.4rem); }
  .workflow-copy p:not(.eyebrow) { color: #aebbd0; }
  .workflow-copy .eyebrow { color: #7f9cff; }
  .text-link { color: #2457d6; font-weight: 750; text-decoration: none; }
  .workflow-copy .text-link { color: #8ba7ff; }
  .text-link span { display: inline-block; margin-left: .25rem; transition: transform .18s ease; }
  .text-link:hover span { transform: translateX(.2rem); }
  .workflow-steps { list-style: none; margin: 0; max-width: none; padding: 0; }
  .workflow-steps li { align-items: center; border-top: 1px solid #324055; display: grid; gap: 1rem; grid-template-columns: 2.2rem 1fr; padding: 1.1rem 0; }
  .workflow-steps li:last-child { border-bottom: 1px solid #324055; }
  .workflow-steps li > span { color: #31b8c7; font: 700 .7rem/1 ui-monospace, monospace; }
  .workflow-steps div { display: flex; flex-direction: column; }
  .workflow-steps small { color: #94a3b8; }
  .open-section { align-items: center; display: grid; gap: clamp(3rem, 7vw, 7rem); grid-template-columns: 1fr 1fr; margin-bottom: 7rem; }
  .code-card { background: #111827; border-radius: .75rem; box-shadow: 1.1rem 1.1rem 0 #dce6f5; color: #dce7f7; overflow: hidden; }
  .code-top { border-bottom: 1px solid #2b374a; display: flex; gap: .4rem; padding: .8rem; }
  .code-card pre { margin: 0; padding: 2rem; }
  .code-card code { background: transparent; color: #aebbd0; font-size: .86rem; line-height: 2; }
  .code-card code b { color: white; }.code-card code span { color: #31b8c7; }
  .local-section { align-items: center; background: #eaf0ff; border-left: .35rem solid #2457d6; display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; margin-bottom: 5rem; padding: 2.5rem; }
  .local-section h2 { margin-bottom: 0; }
  .download-section { margin-bottom: 5rem; }
  .cta-band { align-items: center; background: #2457d6; color: white; display: flex; gap: 2rem; justify-content: space-between; margin: 0 calc(50% - 50vw) -5rem; padding: 4.5rem max(1.5rem, calc((100vw - 69rem) / 2)); }
  .cta-band .eyebrow { color: #c9d6ff; }.cta-band h2 { max-width: 17ch; }.cta-band p:not(.eyebrow) { color: #dfe8ff; }
  .cta-actions { align-items: flex-end; display: flex; flex-direction: column; gap: 1rem; white-space: nowrap; }
  .cta-actions .button.light { background: white; color: #173c9d; }
  .cta-actions > a:not(.button) { color: white; font-size: .88rem; }
  @media (max-width: 58rem) {
    .hero { grid-template-columns: 1fr; }.hero::before { left: 25%; }.workspace { margin-inline: auto; max-width: 40rem; transform: none; width: 100%; }
    .feature-grid { grid-template-columns: 1fr; }.feature-card { min-height: auto; }.feature-card h3 { margin-top: 2.5rem; }.feature-card.featured { transform: none; }
    .workflow-section, .open-section, .local-section { grid-template-columns: 1fr; }.open-section .code-card { max-width: 36rem; width: 100%; }
  }
  @media (max-width: 42rem) {
    .hero { min-height: auto; padding-top: 0; }.hero h1 { font-size: clamp(2.8rem, 14vw, 4rem); }.workspace-body { grid-template-columns: 1fr; }.workspace aside { display: none; }.profile-board { padding: .9rem; }
    .proof-row { grid-template-columns: 1fr 1fr; margin-bottom: 5rem; }.proof-row div:nth-child(3) { border-left: 0; border-top: 1px solid #dbe3ee; }.proof-row div:nth-child(4) { border-top: 1px solid #dbe3ee; }
    .workflow-section { gap: 2rem; padding-block: 3.5rem; }.open-section { margin-bottom: 5rem; }.local-section { gap: 1rem; padding: 1.5rem; }
    .cta-band { align-items: flex-start; flex-direction: column; padding-block: 3.5rem; }.cta-actions { align-items: flex-start; white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) { .text-link span { transition: none; } }
</style>
