---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingPlans from '../components/PricingPlans.astro';
---
<BaseLayout
  title="Pricing — Free Antidetect Browser"
  description="AliasMode Cloud and Local are free with unlimited browser profiles. Premium Support adds direct help without locking product functionality behind payment."
>
  <section class="pricing-hero">
    <p class="eyebrow">Simple pricing</p>
    <h1>Every feature is free.</h1>
    <p class="lead">Choose Cloud for sync and teamwork or Local for account-free use. Pay only when your team wants Premium Support.</p>
  </section>

  <PricingPlans />

  <section class="pricing-note">
    <div><p class="eyebrow">Free from the start</p><h2>Use the full product without upgrading.</h2></div>
    <div><p>Cloud and Local include complete AliasMode functionality. Premium Support gives growing teams onboarding and direct help—it does not unlock extra product features.</p><a class="button" href="/download/">Download AliasMode free</a></div>
  </section>
</BaseLayout>

<style>
  .pricing-hero { margin: 2rem auto 3.5rem; text-align: center; }
  .pricing-hero h1 { font-size: clamp(3rem, 6vw, 5.2rem); margin-inline: auto; max-width: 13ch; }
  .pricing-hero .lead { margin-inline: auto; max-width: 52ch; }
  .pricing-note { align-items: start; background: #111827; color: white; display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; margin-top: 6rem; padding: clamp(1.5rem, 4vw, 3rem); }
  .pricing-note .eyebrow { color: #8da7ff; }
  .pricing-note h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .pricing-note p:not(.eyebrow) { color: #b7c3d5; }
  .pricing-note .button { margin-top: 1rem; }
  @media (max-width: 46rem) { .pricing-hero { margin-top: 0; }.pricing-note { gap: 1rem; grid-template-columns: 1fr; } }
</style>
