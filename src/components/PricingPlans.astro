---
import { siteConfig } from '../../site.config.mjs';

const donationHref = siteConfig.supportEmail
  ? `mailto:${siteConfig.supportEmail}?subject=AliasMode%20Donation`
  : '/contact/';
---
<section class="plans" aria-label="AliasMode plans">
  <div class="pricing-message"><strong>All AliasMode functionality is free.</strong><span>AliasMode is a non-profit project supported by optional donations.</span></div>
  <div class="pricing-grid">
    <article class="plan cloud-plan">
      <div class="plan-top"><div><p class="plan-label">Recommended</p><h3>Cloud</h3></div><span class="plan-badge">Free</span></div>
      <div class="price"><strong>$0</strong><span>Full product access</span></div>
      <p>Manage unlimited profiles, synchronize your work, and collaborate with your team.</p>
      <ul>
        <li>Unlimited browser profiles</li>
        <li>Isolated browser identities</li>
        <li>Encrypted portable-profile sync</li>
        <li>One workspace with owner/member roles</li>
        <li>Device revocation and trash</li>
      </ul>
      <a class="plan-button primary" href="/download/" data-track-cta data-cta-type="cloud-signup" data-page-group="pricing" data-destination="download">Download &amp; sign up free</a>
    </article>

    <article class="plan local-plan">
      <div class="plan-top"><div><p class="plan-label">Account-free</p><h3>Local</h3></div><span class="plan-badge">Free</span></div>
      <div class="price"><strong>$0</strong><span>Unlimited local use</span></div>
      <p>Keep your browser profiles on one computer and work without an AliasMode account.</p>
      <ul>
        <li>Unlimited on-device profiles</li>
        <li>Isolated browser identities</li>
        <li>No account required</li>
        <li>No AliasMode Cloud traffic</li>
        <li>Open-source desktop app</li>
      </ul>
      <a class="plan-button secondary" href="/download/" data-track-cta data-cta-type="download" data-page-group="pricing" data-destination="local">Download Local</a>
    </article>

    <article class="plan donation-plan">
      <div class="plan-top"><div><p class="plan-label">Support the project</p><h3>Donate</h3></div></div>
      <div class="donation-price"><strong>Optional</strong><span>Help fund development</span></div>
      <p>AliasMode is a non-profit project. If it is useful to you, email us to discuss a donation.</p>
      <ul>
        <li>Support ongoing development</li>
        <li>Help cover project infrastructure</li>
        <li>Keep Cloud and Local free</li>
        <li>No feature gates or paid tiers</li>
        <li>Donate only if you want to</li>
      </ul>
      <a class="plan-button dark" href={donationHref}>Email us about donating</a>
    </article>
  </div>
</section>

<style>
  .plans { margin: 2rem 0 0; }
  .pricing-message { align-items: center; background: var(--violet-soft); border-radius: var(--r-md); display: flex; gap: .6rem 1.2rem; justify-content: center; margin-bottom: .8rem; padding: 1rem 1.3rem; text-align: center; }
  .pricing-message strong { color: var(--violet-ink); }
  .pricing-message span { color: var(--ink-2); font-size: .85rem; }
  .pricing-grid { display: grid; gap: .8rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .plan { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r-lg); display: flex; flex-direction: column; min-width: 0; padding: clamp(1.5rem, 2.6vw, 2rem); }
  .cloud-plan { background: linear-gradient(162deg, #7c5cff, #5a35e6 68%, #4b2bd6); border-color: transparent; box-shadow: 0 1.2rem 2.8rem -1rem rgba(109, 74, 255, .5); color: #fff; transform: translateY(-.6rem); }
  .plan-top { align-items: flex-start; display: flex; gap: 1rem; justify-content: space-between; }
  .plan-label { color: var(--violet); font: 700 .64rem/1.2 var(--font-mono); letter-spacing: .12em; margin: 0 0 .4rem; text-transform: uppercase; }
  .cloud-plan .plan-label { color: #d3c4ff; }
  .plan h3 { font-size: 1.6rem; margin: 0; }
  .plan-badge { background: var(--violet-soft); border-radius: var(--r-pill); color: var(--violet-ink); font-size: .66rem; font-weight: 800; letter-spacing: .05em; padding: .32rem .65rem; text-transform: uppercase; }
  .cloud-plan .plan-badge { background: rgba(255, 255, 255, .2); color: #fff; }
  .price { align-items: baseline; display: flex; flex-wrap: wrap; gap: .25rem .65rem; margin: 2rem 0 1rem; }
  .price strong { font-family: var(--font-display); font-size: 3.4rem; letter-spacing: -.06em; line-height: .85; }
  .price span, .donation-price span { color: var(--ink-3); font-size: .72rem; }
  .cloud-plan .price span { color: #d3c4ff; }
  .donation-price { display: flex; flex-direction: column; margin: 2rem 0 1rem; min-height: 3rem; }
  .donation-price strong { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: -.04em; }
  .plan > p { color: var(--ink-2); font-size: .86rem; min-height: 4.1rem; }
  .cloud-plan > p { color: #e0d6ff; }
  .plan ul { flex: 1; list-style: none; margin: 1rem 0 1.7rem; padding: 0; }
  .plan li { font-size: .8rem; padding-left: 1.3rem; position: relative; }
  .plan li::before { color: var(--violet); content: '\2713'; font-weight: 900; left: 0; position: absolute; }
  .cloud-plan li { color: #ece5ff; }
  .cloud-plan li::before { color: #b9ffef; }
  .plan li + li { margin-top: .55rem; }
  .plan-button { border-radius: var(--r-pill); display: block; font-size: .85rem; font-weight: 700; padding: .8rem 1rem; text-align: center; text-decoration: none; transition: filter .18s ease, transform .18s ease; }
  .plan-button.primary { background: #fff; color: var(--violet-ink); }
  .plan-button.secondary { background: var(--violet-soft); box-shadow: inset 0 0 0 1px var(--violet-line); color: var(--violet-deep); }
  .plan-button.dark { background: var(--night); color: #fff; }
  .plan-button:hover { filter: brightness(.97); transform: translateY(-1px); }
  @media (max-width: 58rem) { .pricing-grid { grid-template-columns: 1fr; }.cloud-plan { transform: none; }.plan > p { min-height: auto; }.pricing-message { align-items: flex-start; flex-direction: column; text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .plan-button { transition: none; } }
</style>
