---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
import GitHubButton from '../components/GitHubButton.astro';
import PricingPlans from '../components/PricingPlans.astro';
import DetectionTable from '../components/DetectionTable.astro';
---
<BaseLayout
  title="Free Open-Source Antidetect Browser"
  description="AliasMode is a free, open-source antidetect browser for managing multiple accounts. Create unlimited profiles, sync across devices, and work with your team."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Free &amp; open source · Windows beta</p>
      <h1>The free, open-source <span>antidetect browser</span> for managing multiple accounts.</h1>
      <p class="lead">Create unlimited isolated browser profiles, sync them across your devices, and collaborate with your team or your AI agents from one workspace.</p>
      <div class="actions">
        <a class="button" href="/download/">Download &amp; sign up free</a>
        <GitHubButton href="https://github.com/aliasmode/aliasmode" label="View on GitHub" tone="outline" />
      </div>
      <p class="hero-note"><a href="/local/">Prefer no account? Use Local mode.</a></p>
    </div>

    <div class="workspace" role="img" aria-label="AliasMode workspace with separate synchronized browser profiles">
      <div class="window-bar"><span></span><span></span><span></span><b>AliasMode</b></div>
      <div class="workspace-body">
        <aside>
          <div class="mini-brand"><svg viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#31B8C7" stroke-width="64" stroke-linecap="round"/></svg><strong>Profiles</strong></div>
          <span class="nav-active">All profiles <b>∞</b></span>
          <span>Workspace</span>
          <span>Team</span>
        </aside>
        <div class="profile-board">
          <div class="board-head"><div><small>Your workspace</small><strong>Browser profiles</strong></div><button type="button" tabindex="-1">+ New profile</button></div>
          <div class="profile-row"><span class="profile-icon cobalt">A</span><div><strong>Agency workspace</strong><small>Cloud profile</small></div><span class="status">Synced</span><span class="dots">•••</span></div>
          <div class="profile-row"><span class="profile-icon cyan">S</span><div><strong>Storefront</strong><small>Cloud profile</small></div><span class="status">Synced</span><span class="dots">•••</span></div>
          <div class="profile-row"><span class="profile-icon navy">C</span><div><strong>Client account</strong><small>Cloud profile</small></div><span class="status active">Open</span><span class="dots">•••</span></div>
          <div class="team-row"><span>Workspace members</span><div class="avatars"><i>AM</i><i>JD</i><i>+2</i></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-row" aria-label="Product highlights">
    <div><strong>Free</strong><span>No profile fees</span></div>
    <div><strong>Open source</strong><span>Built in public</span></div>
    <div><strong>Unlimited</strong><span>Browser profiles</span></div>
    <div><strong>Cloud ready</strong><span>Sync and teams</span></div>
  </section>

  <section class="section-intro" id="features">
    <p class="eyebrow">One browser. Every account.</p>
    <h2>Manage more accounts without paying more.</h2>
    <p class="lead">Give every account its own browser identity, then keep your work organized across devices and teammates.</p>
  </section>

  <div class="feature-grid">
    <article class="feature-card">
      <span class="feature-number">01</span>
      <h3>Unlimited profiles</h3>
      <p>Create a separate profile for every account, client, brand, or project. Add as many as your work needs.</p>
    </article>
    <article class="feature-card featured">
      <span class="feature-number">02</span>
      <h3>Isolated identities</h3>
      <p>Each profile keeps its own browser identity, cookies, sessions, and storage so your accounts stay separate.</p>
    </article>
    <article class="feature-card">
      <span class="feature-number">03</span>
      <h3>Cloud teamwork</h3>
      <p>Sync encrypted portable profiles, invite teammates, and work together, people and AI agents, through one shared workspace.</p>
    </article>
  </div>

  <DetectionTable
    eyebrow="Detection-tested runtime"
    heading="Passes the bot checks real platforms use."
    lead="Every AliasMode profile opens in CloakBrowser, a Chrome-based runtime patched at the source, so websites see a normal human-driven browser, not an automation tool. Here is how it compares on the public detection services that platforms use to screen visitors."
  />

  <section class="workflow-section">
    <div class="workflow-copy">
      <p class="eyebrow">Start in minutes</p>
      <h2>Download. Create. Sync. Share.</h2>
      <p>Install AliasMode on Windows and create your free Cloud account inside the app. Your profiles are ready when your work moves to another device or teammate.</p>
      <a class="text-link" href="/download/">Get AliasMode free <span>→</span></a>
    </div>
    <ol class="workflow-steps">
      <li><span>1</span><div><strong>Download AliasMode</strong><small>Install the Windows beta.</small></div></li>
      <li><span>2</span><div><strong>Create your free account</strong><small>Choose Cloud inside the app.</small></div></li>
      <li><span>3</span><div><strong>Build your profiles</strong><small>Keep every account separate.</small></div></li>
      <li><span>4</span><div><strong>Sync or invite</strong><small>Move across devices or add your team.</small></div></li>
    </ol>
  </section>

  <section class="api-section" id="api">
    <div class="api-copy">
      <p class="eyebrow">Browser automation API</p>
      <h2>Automate profiles with the tools you already use.</h2>
      <p>Open profiles through an AdsPower-compatible local API, then automate them over Playwright CDP.</p>
      <ul><li>Start and stop browser profiles through HTTP.</li><li>Check profile and service status programmatically.</li><li>Connect Playwright directly to the running browser over CDP.</li><li>Run AI browser agents on the same CDP endpoint. Profiles pass the bot checks that block stock automated browsers.</li></ul>
      <div class="actions"><a class="button" href="/docs/local-api/">Read the Local API</a><a class="button secondary" href="/integrations/playwright/">Use Playwright</a></div>
    </div>
    <div class="api-code" aria-label="Playwright API connection example">
      <div class="code-top"><span></span><span></span><span></span><b>automation.js</b></div>
      <pre><code><span>GET</span> /api/v1/browser/start
    ?user_id=PROFILE_ID

<span>const</span> browser = <span>await</span>
  chromium.connectOverCDP(
    response.data.ws.puppeteer
  )</code></pre>
    </div>
  </section>

  <section class="open-section">
    <div class="code-card" aria-hidden="true"><div class="code-top"><span></span><span></span><span></span></div><pre><code><b>aliasmode</b>/aliasmode

<span>★</span> free and open source
<span>✓</span> inspect the code
<span>↗</span> follow every release</code></pre></div>
    <div>
      <p class="eyebrow">Open by default</p>
      <h2>Built in the open.</h2>
      <p>The AliasMode desktop client is Apache-2.0 open source. Read the code, follow releases, report issues, and contribute directly. CloakBrowser installs separately under its own license, and AliasMode Cloud is a managed service.</p>
      <div class="actions"><GitHubButton href="https://github.com/aliasmode/aliasmode" label="Explore the project on GitHub" /><a class="button secondary" href="/product/">See the product architecture</a></div>
    </div>
  </section>

  <section class="local-section">
    <div><p class="eyebrow">Local mode</p><h2>Want to work without an account?</h2></div>
    <div><p>Use AliasMode Local. Your profile data stays on that computer and AliasMode sends no traffic to Cloud.</p><a class="text-link" href="/local/">Explore account-free Local mode <span>→</span></a></div>
  </section>

  <section class="pathways-section">
    <div class="section-intro">
      <p class="eyebrow">Built for real account work</p>
      <h2>Move from profiles to a repeatable workflow.</h2>
      <p class="lead">Organize authorized client sessions, assign proxies, connect automation, and compare the operating model with established tools.</p>
    </div>
    <div class="pathways-grid">
      <a href="/agencies/"><span>Agency operations</span><strong>Separate client sessions and team handoffs.</strong><small>AliasMode for agencies →</small></a>
      <a href="/alternatives/"><span>Product evaluation</span><strong>Compare price, source, Local, Cloud, and APIs.</strong><small>Browse alternatives →</small></a>
      <a href="/use-cases/ai-agents/"><span>AI agents</span><strong>Browse without bot walls over CDP.</strong><small>Run AI agents on AliasMode →</small></a>
      <a href="/docs/proxies/"><span>Proxy setup</span><strong>Configure HTTP, HTTPS, and SOCKS5 per profile.</strong><small>Read proxy documentation →</small></a>
      <a href="/docs/"><span>Documentation</span><strong>Install, create profiles, troubleshoot, and automate.</strong><small>Open the docs →</small></a>
    </div>
  </section>

  <section class="maker-section">
    <p class="eyebrow">Developed by Xreacher</p>
    <div><h2>Built for real multi-account operations.</h2><p>The Xreacher team developed AliasMode for its own work and used it internally for months before releasing it as a free, open-source product.</p><a class="text-link" href="/about/">Read the AliasMode story <span>→</span></a></div>
  </section>

  <section class="pricing-section" id="pricing">
    <div class="section-intro">
      <p class="eyebrow">Simple pricing</p>
      <h2>Every feature is free.</h2>
      <p class="lead">Choose Cloud or Local at no cost. AliasMode is a non-profit project supported by optional donations.</p>
    </div>
    <PricingPlans />
  </section>

  <section class="download-section">
    <DownloadPanel />
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(27rem, .95fr); gap: clamp(2.5rem, 5vw, 5rem); align-items: center; min-height: 32rem; padding: 2rem 0 4.5rem; position: relative; }
  .hero::before { background-image: linear-gradient(#dbe6f5 1px, transparent 1px), linear-gradient(90deg, #dbe6f5 1px, transparent 1px); background-size: 3rem 3rem; content: ''; inset: -3rem calc(50% - 50vw) auto 52%; height: 35rem; mask-image: linear-gradient(to bottom, rgba(0,0,0,.7), transparent); opacity: .45; pointer-events: none; position: absolute; z-index: -1; }
  .hero h1 { font-size: clamp(2.8rem, 4.2vw, 4.4rem); max-width: 17ch; }
  .hero h1 span { background: linear-gradient(100deg, #2b63e8, #31b8c7); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-note { color: #526077; font-size: .88rem; margin: -.7rem 0 0; }
  .workspace { background: #0f1622; border: 1px solid #293447; border-radius: 1rem; box-shadow: 0 1.2rem 2.4rem rgba(21, 44, 79, .18), 0 3rem 6rem rgba(21, 44, 79, .22); color: #dbe7f7; min-width: 0; overflow: hidden; transform: rotate(1deg); transition: transform .35s ease, box-shadow .35s ease; }
  .workspace:hover { box-shadow: 0 1.6rem 3rem rgba(21, 44, 79, .2), 0 3.6rem 7rem rgba(21, 44, 79, .26); transform: rotate(0deg) translateY(-4px); }
  .window-bar { align-items: center; border-bottom: 1px solid #293447; display: flex; gap: .4rem; height: 2.6rem; padding: 0 .8rem; }
  .window-bar span, .code-top span { background: #526174; border-radius: 50%; display: block; height: .48rem; width: .48rem; }
  .window-bar span:first-child, .code-top span:first-child { background: #31b8c7; }
  .window-bar b { color: #8fa0b6; font: 600 .68rem/1 ui-monospace, monospace; margin-left: auto; }
  .workspace-body { display: grid; grid-template-columns: 9rem 1fr; min-height: 25rem; }
  .workspace aside { border-right: 1px solid #293447; display: flex; flex-direction: column; gap: .5rem; padding: 1.2rem .8rem; }
  .workspace aside > span { border-radius: .4rem; color: #8fa0b6; display: flex; font-size: .7rem; justify-content: space-between; padding: .55rem; }
  .workspace aside .nav-active { background: #1d2b40; color: #fff; }
  .mini-brand { align-items: center; display: flex; gap: .45rem; margin-bottom: 1rem; }
  .mini-brand svg { height: 1.35rem; width: 1.35rem; }
  .mini-brand strong { color: #fff; font-size: .75rem; }
  .profile-board { background: #f4f7fb; color: #111827; padding: 1.3rem; }
  .board-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 1rem; }
  .board-head div { display: flex; flex-direction: column; }
  .board-head small { color: #6b7890; font-size: .58rem; text-transform: uppercase; }
  .board-head strong { font-size: 1rem; }
  .board-head button { background: #2457d6; border: 0; border-radius: .4rem; color: white; font-size: .63rem; padding: .52rem .65rem; }
  .profile-row { align-items: center; background: white; border: 1px solid #dce4ee; border-radius: .5rem; display: grid; gap: .7rem; grid-template-columns: auto 1fr auto auto; margin-top: .6rem; padding: .72rem; }
  .profile-row > div { display: flex; flex-direction: column; }
  .profile-row strong { font-size: .7rem; }
  .profile-row small { color: #7a879a; font-size: .56rem; }
  .profile-icon { align-items: center; border-radius: .35rem; color: white; display: flex; font-size: .65rem; font-style: normal; font-weight: 800; height: 1.8rem; justify-content: center; width: 1.8rem; }
  .cobalt { background: #2457d6; } .cyan { background: #168b9a; } .navy { background: #293447; }
  .status { background: #e4f7f0; border-radius: 2rem; color: #137257; font-size: .53rem; font-weight: 700; padding: .25rem .42rem; }
  .status.active { background: #e6edff; color: #2457d6; }
  .dots { color: #9ba7b8; font-size: .65rem; letter-spacing: .08rem; }
  .team-row { align-items: center; color: #65738a; display: flex; font-size: .58rem; justify-content: space-between; margin-top: 1.5rem; }
  .avatars { display: flex; }
  .avatars i { align-items: center; background: #dfe7f3; border: 2px solid #f4f7fb; border-radius: 50%; color: #35445c; display: flex; font-size: .42rem; font-style: normal; font-weight: 800; height: 1.6rem; justify-content: center; margin-left: -.3rem; width: 1.6rem; }
  .proof-row { background: #fff; border: 1px solid #e2e8f2; border-radius: .8rem; box-shadow: 0 .3rem .9rem rgba(23, 45, 84, .05); display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 7rem; overflow: hidden; }
  .proof-row div + div { border-left-color: #edf1f7; }
  .proof-row div { display: flex; flex-direction: column; padding: 1.25rem 1.4rem; }
  .proof-row div + div { border-left: 1px solid #dbe3ee; }
  .proof-row strong { font-size: .9rem; }
  .proof-row span { color: #64748b; font-size: .7rem; }
  .section-intro { margin: 0 auto 2.5rem; text-align: center; }
  .section-intro h2 { font-size: clamp(2.2rem, 4vw, 3.7rem); margin-inline: auto; max-width: 18ch; }
  .section-intro p { margin-inline: auto; }
  .feature-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); margin-bottom: 7rem; }
  .feature-card { background: #fff; border: 1px solid #e2e8f2; border-radius: .9rem; box-shadow: 0 .3rem .9rem rgba(23, 45, 84, .05); min-height: 18rem; padding: 1.8rem; position: relative; transition: box-shadow .2s ease, transform .2s ease; }
  .feature-card:hover { box-shadow: 0 .9rem 2rem rgba(23, 45, 84, .1); transform: translateY(-4px); }
  .feature-card.featured:hover { transform: translateY(calc(-1rem - 4px)); }
  .feature-card.featured { background: linear-gradient(160deg, #2b63e8, #1b46b4); border-color: transparent; box-shadow: 0 1rem 2.4rem rgba(36, 87, 214, .35); color: white; transform: translateY(-1rem); }
  .feature-card h3 { font-size: 1.45rem; margin-top: 5rem; }
  .feature-card p { color: #526077; font-size: .92rem; }
  .feature-card.featured p { color: #dfe8ff; }
  .feature-number { color: #7891b5; font: 700 .72rem/1 ui-monospace, monospace; }
  .feature-card.featured .feature-number { color: #a9bdff; }
  .workflow-section { align-items: center; background: linear-gradient(150deg, #0f1622, #16233a); color: white; display: grid; gap: 4rem; grid-template-columns: .85fr 1.15fr; margin: 0 calc(50% - 50vw) 7rem; padding: 5rem max(1.5rem, calc((100vw - 69rem) / 2)); }
  .workflow-copy h2, .open-section h2, .local-section h2 { font-size: clamp(2rem, 4vw, 3.4rem); }
  .workflow-copy p:not(.eyebrow) { color: #aebbd0; }
  .workflow-copy .eyebrow { color: #7f9cff; }
  .text-link { color: #2457d6; font-weight: 750; text-decoration: none; }
  .workflow-copy .text-link { color: #8ba7ff; }
  .text-link span { display: inline-block; margin-left: .25rem; transition: transform .18s ease; }
  .text-link:hover span { transform: translateX(.2rem); }
  .workflow-steps { list-style: none; margin: 0; max-width: none; padding: 0; }
  .workflow-steps li { align-items: center; border-top: 1px solid #324055; display: grid; gap: 1rem; grid-template-columns: 2.2rem 1fr; padding: 1.1rem 0; }
  .workflow-steps li:last-child { border-bottom: 1px solid #324055; }
  .workflow-steps li > span { color: #31b8c7; font: 700 .7rem/1 ui-monospace, monospace; }
  .workflow-steps div { display: flex; flex-direction: column; }
  .workflow-steps small { color: #94a3b8; }
  .api-section { align-items: stretch; display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: 1fr 1fr; margin-bottom: 7rem; scroll-margin-top: 2rem; }
  .api-copy { padding: 1rem 0; }
  .api-copy h2 { font-size: clamp(2rem, 4vw, 3.4rem); }
  .api-copy ul { color: #526077; font-size: .88rem; margin: 1.4rem 0 1.8rem; }
  .api-code { background: #0f1622; border: 1px solid #293447; border-radius: .9rem; box-shadow: 0 1.4rem 3rem rgba(21, 44, 79, .2); color: #dce7f7; overflow: hidden; }
  .api-code .code-top { align-items: center; display: flex; }
  .api-code .code-top b { color: #8fa0b6; font: 600 .66rem/1 ui-monospace, monospace; margin-left: auto; }
  .api-code pre { margin: 0; overflow-x: auto; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .api-code code { background: transparent; color: #c3d0e1; font-size: clamp(.7rem, 1.4vw, .9rem); line-height: 1.8; white-space: pre; }
  .api-code code span { color: #31b8c7; }
  .open-section { align-items: center; display: grid; gap: clamp(3rem, 7vw, 7rem); grid-template-columns: 1fr 1fr; margin-bottom: 7rem; }
  .code-card { background: #0f1622; border-radius: .9rem; box-shadow: 0 1.4rem 3rem rgba(21, 44, 79, .2); color: #dce7f7; overflow: hidden; }
  .code-top { border-bottom: 1px solid #2b374a; display: flex; gap: .4rem; padding: .8rem; }
  .code-card pre { margin: 0; padding: 2rem; }
  .code-card code { background: transparent; color: #aebbd0; font-size: .86rem; line-height: 2; }
  .code-card code b { color: white; }.code-card code span { color: #31b8c7; }
  .local-section { align-items: center; background: linear-gradient(120deg, #eaf0ff, #e4f6f8); border-radius: .9rem; display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; margin-bottom: 6rem; padding: 2.5rem; }
  .local-section h2 { margin-bottom: 0; }
  .pathways-section { margin-bottom: 6rem; }
  .pathways-grid { display: grid; gap: 1px; grid-template-columns: repeat(2, 1fr); }
  .pathways-grid a { background: #fff; border: 1px solid #e2e8f2; display: flex; flex-direction: column; min-height: 14rem; padding: 1.6rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .pathways-grid a:hover { border-color: #9db3e2; box-shadow: 0 .8rem 1.8rem rgba(23, 45, 84, .09); transform: translateY(-3px); }
  .pathways-grid span { color: #536eae; font: 800 .68rem/1.2 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .pathways-grid strong { font-size: 1.35rem; margin-top: 1.2rem; max-width: 25ch; }
  .pathways-grid small { color: #2457d6; font-size: .82rem; font-weight: 750; margin-top: auto; }
  .maker-section { align-items: start; border-bottom: 1px solid #dbe3ee; border-top: 1px solid #dbe3ee; display: grid; gap: 3rem; grid-template-columns: .55fr 1.45fr; margin-bottom: 6rem; padding: 3rem 0; }
  .maker-section h2 { font-size: clamp(2rem, 4vw, 3.2rem); }
  .pricing-section { margin-bottom: 5rem; scroll-margin-top: 2rem; }
  .pricing-section .section-intro { margin-bottom: 2rem; }
  .download-section { margin-bottom: 0; }
  @media (max-width: 58rem) {
    .hero { grid-template-columns: 1fr; }.hero::before { left: 25%; }.workspace { margin-inline: auto; max-width: 40rem; transform: none; width: 100%; }
    .feature-grid { grid-template-columns: 1fr; }.feature-card { min-height: auto; }.feature-card h3 { margin-top: 2.5rem; }.feature-card.featured { transform: none; }
    .workflow-section, .api-section, .open-section, .local-section, .maker-section { grid-template-columns: 1fr; }.open-section .code-card { max-width: 36rem; width: 100%; }
  }
  @media (max-width: 42rem) {
    .hero { min-height: auto; padding-top: 0; }.hero h1 { font-size: clamp(2.5rem, 10.5vw, 3.25rem); max-width: 15ch; }.workspace-body { grid-template-columns: 1fr; }.workspace aside { display: none; }.profile-board { padding: .9rem; }
    .proof-row { grid-template-columns: 1fr 1fr; margin-bottom: 5rem; }.proof-row div:nth-child(3) { border-left: 0; border-top: 1px solid #dbe3ee; }.proof-row div:nth-child(4) { border-top: 1px solid #dbe3ee; }
    .workflow-section { gap: 2rem; padding-block: 3.5rem; }.open-section { margin-bottom: 5rem; }.local-section { gap: 1rem; padding: 1.5rem; }.pathways-grid { grid-template-columns: 1fr; }.maker-section { gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .text-link span { transition: none; } }
</style>
