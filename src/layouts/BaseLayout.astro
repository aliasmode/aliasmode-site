---
import { siteConfig } from '../../site.config.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GitHubButton from '../components/GitHubButton.astro';
import { canonicalPath, getBreadcrumbs, getSiteRoute } from '../data/site-routes';

interface Props { title?: string; description?: string; noIndex?: boolean; canonical?: boolean; layout?: 'panel' | 'sections' }
const {
  title = 'Free Open-Source Antidetect Browser',
  description = 'AliasMode is a free, open-source antidetect browser for managing multiple accounts.',
  noIndex = false,
  canonical: includeCanonical = true,
  layout = 'panel',
} = Astro.props;
const route = getSiteRoute(Astro.url.pathname);
const routePath = route?.path ?? canonicalPath(Astro.url.pathname);
const resolvedTitle = route?.title ?? title;
const resolvedDescription = route?.description ?? description;
const fullTitle = `${resolvedTitle} · AliasMode`;
const shouldIndex = siteConfig.index && !noIndex;
const canonical = shouldIndex && includeCanonical ? new URL(routePath, siteConfig.origin).toString() : undefined;
const metadataUrl = new URL(routePath, siteConfig.metadataOrigin).toString();
const socialImage = new URL('/social/aliasmode-open-source-antidetect-browser.png', siteConfig.metadataOrigin).toString();
const breadcrumbs = route ? getBreadcrumbs(route) : [];
const organizationId = `${siteConfig.metadataOrigin}/#organization`;
const schemas: Record<string, unknown>[] = [];

if (route) {
  schemas.push({
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Xreacher',
    url: 'https://xreacher.com/',
    brand: { '@type': 'Brand', name: 'AliasMode', url: siteConfig.metadataOrigin },
  });
}
if (route?.kind === 'home') {
  schemas.push({
    '@type': 'WebSite',
    '@id': `${siteConfig.metadataOrigin}/#website`,
    url: siteConfig.metadataOrigin,
    name: 'AliasMode',
    description: resolvedDescription,
    publisher: { '@id': organizationId },
  });
}
if (route && (route.kind === 'product' || route.kind === 'home')) {
  schemas.push({
    '@type': 'SoftwareApplication',
    name: 'AliasMode',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows',
    url: metadataUrl,
    description: resolvedDescription,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': organizationId },
  });
}
if (route && ['documentation', 'comparison', 'integration', 'use-case', 'guide', 'article'].includes(route.kind)) {
  schemas.push({
    '@type': route.kind === 'documentation' ? 'TechArticle' : 'Article',
    headline: resolvedTitle,
    description: resolvedDescription,
    url: metadataUrl,
    dateModified: '2026-08-10',
    author: { '@id': organizationId },
    publisher: { '@id': organizationId },
  });
}
if (breadcrumbs.length > 1) {
  schemas.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.path, siteConfig.metadataOrigin).toString(),
    })),
  });
}
const structuredData = schemas.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemas }).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#6d4aff" />
    <meta property="og:site_name" content="AliasMode" />
    <meta property="og:type" content={route?.kind === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={metadataUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AliasMode: free, open-source antidetect browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Inter:opsz,wght@14..32,400..900&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!shouldIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {siteConfig.googleSiteVerification && !noIndex && <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />}
    {siteConfig.bingSiteVerification && !noIndex && <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#6d4aff" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/></svg>AliasMode <span>by Xreacher</span></a>
        <nav class="main-nav" aria-label="Main navigation"><a href="/product/">Product</a><a href="/agencies/">Agencies</a><a href="/docs/">Docs</a><a href="/alternatives/">Alternatives</a><a href="/pricing/">Pricing</a></nav>
        <a class="header-cta" href="/download/">Download free</a>
      </header>
      <main class:list={[{ sectioned: layout === 'sections' }]}>
        {route && <Breadcrumbs route={route} />}
        <slot />
      </main>
      <footer>
        <div class="footer-cols">
        <div class="footer-brand"><strong>AliasMode</strong><span>Free, open-source multi-account browsing.</span><GitHubButton href={siteConfig.githubRepository} label="GitHub" tone="light" compact /></div>
        <nav aria-label="Product navigation"><strong>Product</strong><a href="/download/">Download</a><a href="/local/">Local</a><a href="/cloud/">Cloud</a><a href="/security/">Security</a></nav>
        <nav aria-label="Resource navigation"><strong>Resources</strong><a href="/docs/">Documentation</a><a href="/integrations/">Integrations</a><a href="/guides/">Guides</a><a href="/tools/">Tools</a></nav>
        <nav aria-label="Company and legal navigation"><strong>Company</strong><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/terms/">Terms</a><a href="/privacy/">Privacy</a><a href="/acceptable-use/">Acceptable Use</a></nav>
        </div>
        <p class="footer-mark" aria-hidden="true">AliasMode</p>
      </footer>
    </div>
    {siteConfig.analyticsEndpoint && !noIndex && (
      <script is:inline define:vars={{ endpoint: siteConfig.analyticsEndpoint }}>
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('[data-track-cta]');
          if (!(link instanceof HTMLElement)) return;
          const body = JSON.stringify({
            pageGroup: link.dataset.pageGroup,
            ctaType: link.dataset.ctaType,
            destination: link.dataset.destination,
            campaign: link.dataset.campaign || undefined,
          });
          navigator.sendBeacon(endpoint, new Blob([body], { type: 'application/json' }));
        });
      </script>
    )}
  </body>
</html>
<style is:global>
  :root {
    /* Brand */
    --violet: #6d4aff;
    --violet-deep: #4b2bd6;
    --violet-ink: #2e1b7a;
    --violet-soft: #f1ecff;
    --violet-line: #ded4ff;
    --peach: #ff9e7a;
    --peach-soft: #ffeee6;
    /* Signals */
    --signal: #00a49d;
    --signal-soft: #ddf3f1;
    --pass: #0e6b45;
    --pass-soft: #ddf2e7;
    --fail: #b3382e;
    --fail-soft: #fbe8e4;
    --warn: #c2740c;
    /* Ink and surfaces */
    --ink: #14121f;
    --ink-2: #56506e;
    --ink-3: #736c92;
    --line: #ece7f8;
    --line-2: #ddd6ee;
    --panel: #ffffff;
    --panel-2: #faf8ff;
    --panel-warm: #fdf9f6;
    /* Dark surfaces */
    --night: #17142a;
    --night-2: #201c39;
    --night-3: #2b2550;
    --night-line: #332c58;
    --night-ink: #d3cbf0;
    --night-ink-2: #9990bc;
    /* Geometry */
    --site-max: 84rem;
    --read-max: 72rem;
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
    --header-h: 4.6rem;
    --pad: clamp(1.15rem, 3.6vw, 3.25rem);
    --r-panel: 2rem;
    --r-lg: 1.5rem;
    --r-md: 1.1rem;
    --r-sm: .6rem;
    --r-pill: 999px;
    /* Elevation, tinted violet rather than neutral grey */
    --shadow-sm: 0 1px 2px rgba(46, 27, 122, .05), 0 8px 20px -14px rgba(46, 27, 122, .22);
    --shadow-md: 0 2px 6px rgba(46, 27, 122, .05), 0 18px 40px -20px rgba(46, 27, 122, .3);
    --shadow-lg: 0 30px 64px -30px rgba(46, 27, 122, .45);
    --shadow-shell: 0 .5rem 1.75rem -.75rem rgba(30, 10, 80, .5);
    --shadow-violet: 0 .7rem 1.6rem -.5rem rgba(109, 74, 255, .5);
    /* Type */
    --font-display: "Bricolage Grotesque", "Inter", Aptos, "Segoe UI", ui-sans-serif, system-ui, sans-serif;
    --font-body: "Inter", Aptos, "Segoe UI", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace;

    color: var(--ink);
    font-family: var(--font-body);
    font-feature-settings: "cv11", "ss01";
    line-height: 1.6;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  /* Canvas gradient lives on the root background box so it stays one cheap
     paint. A fixed overlay layer here forces main-thread scrolling. */
  html { background: linear-gradient(172deg, #ece5f9 0%, #f3ecf7 45%, #fbefe8 100%); background-attachment: scroll; min-height: 100%; }
  body { margin: 0; overflow-x: hidden; }
  ::selection { background: rgba(109, 74, 255, .2); }
  [id] { scroll-margin-top: 6rem; }
  a { color: inherit; text-underline-offset: .18em; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { border-radius: .3rem; outline: 3px solid var(--violet); outline-offset: 3px; }

  /* A normal, continuous landing page: full-width bands, content in a centred
     column. No floating panel, no gaps between sections. */
  .shell { background: var(--panel); box-shadow: 0 0 0 1px rgba(46, 27, 122, .06); display: block; margin-inline: auto; max-width: var(--site-max); min-height: 100vh; }

  /* Floating pill, riding above the bands rather than sitting in the flow. */
  .site-header {
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-md);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: auto 1fr auto;
    left: 50%;
    padding: .5rem .5rem .5rem 1.2rem;
    position: fixed;
    top: .75rem;
    transform: translateX(-50%);
    width: min(calc(var(--site-max) - var(--gutter) * 2), calc(100% - var(--gutter) * 2));
    z-index: 50;
  }
  .main-nav { justify-content: center; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem; font-size: .88rem; }
  nav a { border-radius: var(--r-pill); color: var(--ink-2); font-weight: 600; padding: .45rem .8rem; text-decoration: none; transition: background .15s ease, color .15s ease; }
  nav a:hover { background: var(--violet-soft); color: var(--violet-deep); }
  .brand { align-items: center; color: var(--ink); display: inline-flex; font-family: var(--font-display); font-size: 1.12rem; font-weight: 700; gap: .5rem; letter-spacing: -.03em; text-decoration: none; white-space: nowrap; }
  .brand-mark { height: 1.7rem; width: 1.7rem; }
  .brand span { color: var(--ink-3); font-family: var(--font-body); font-size: .74rem; font-weight: 550; letter-spacing: 0; }
  .header-cta { background: linear-gradient(175deg, #7c5cff, var(--violet)); border-radius: var(--r-pill); box-shadow: var(--shadow-violet); color: #fff; font-size: .84rem; font-weight: 700; padding: .68rem 1.2rem; text-decoration: none; transition: box-shadow .18s ease, transform .18s ease, filter .18s ease; white-space: nowrap; }
  .header-cta:hover { filter: brightness(1.07); box-shadow: 0 .9rem 2rem -.5rem rgba(109, 74, 255, .6); transform: translateY(-1px); }

  /* Content pages get a centred reading column; a landing page lays out its
     own full-width bands with layout="sections". */
  main { display: block; }
  main:not(.sectioned) { margin-inline: auto; max-width: var(--read-max); padding: calc(var(--header-h) + clamp(1.5rem, 3vw, 2.5rem)) var(--gutter) clamp(3.5rem, 6vw, 5rem); }

  /* Full-width section bands */
  .surface { padding: clamp(3rem, 6vw, 5rem) var(--gutter); }
  .surface-light { background: var(--panel); }
  .surface-tint { background: var(--panel-2); }
  .surface-warm { background: var(--panel-warm); }
  .surface-dark { background: linear-gradient(152deg, var(--night), #241d47); color: #fff; }
  .surface-dark .eyebrow { color: #b7a1ff; }
  .surface-dark p:not(.eyebrow), .surface-dark li, .surface-dark dd { color: var(--night-ink); }
  .surface-dark .lead { color: var(--night-ink); }
  .surface-dark .text-link { color: #b7a1ff; }
  .surface + .surface-light + .surface-light { border-top: 1px solid var(--line); }

  .shell > footer { background: linear-gradient(155deg, var(--night), #241d47); color: var(--night-ink); overflow: hidden; padding: clamp(2.75rem, 5vw, 3.5rem) var(--gutter) 0; }
  .footer-cols { align-items: flex-start; display: grid; font-size: .82rem; gap: 2rem; grid-template-columns: 1.5fr repeat(3, 1fr); }
  .shell > footer nav { align-items: flex-start; flex-direction: column; gap: .15rem; }
  .shell > footer nav a { color: var(--night-ink); padding-inline: 0; }
  .shell > footer nav a:hover { background: none; color: #fff; text-decoration: underline; }
  .shell > footer nav strong { color: #fff; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; margin-bottom: .55rem; text-transform: uppercase; }
  .footer-brand { align-items: flex-start; display: flex; flex-direction: column; gap: .5rem; }
  .footer-brand strong { color: #fff; font-family: var(--font-display); font-size: 1.1rem; letter-spacing: -.02em; }
  .footer-brand span { color: var(--night-ink-2); }
  /* Wordmark watermark, clipped by the bottom of the page. */
  .footer-mark { -webkit-background-clip: text; background-clip: text; background-image: linear-gradient(180deg, rgba(183, 161, 255, .34), rgba(183, 161, 255, .03)); color: transparent; font-family: var(--font-display); font-size: clamp(3.4rem, 16vw, 14rem); font-weight: 800; letter-spacing: -.06em; line-height: .74; margin: clamp(1.75rem, 4vw, 3rem) 0 -.13em; max-width: none; text-align: center; user-select: none; white-space: nowrap; }


  /* Type: Bricolage Grotesque carries every heading, Inter carries the reading. */
  h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
  h1 { font-size: clamp(2.4rem, 5.1vw, 4.4rem); letter-spacing: -.045em; line-height: .95; margin: 0 0 1.35rem; max-width: 14ch; text-wrap: balance; }
  h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); letter-spacing: -.035em; line-height: 1.06; margin: 0 0 .75rem; text-wrap: balance; }
  h3 { font-size: 1.15rem; letter-spacing: -.025em; margin-bottom: .3rem; }
  p { max-width: 68ch; }
  .eyebrow { color: var(--violet); font: 700 .7rem/1.2 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .lead { color: var(--ink-2); font-size: 1.16rem; max-width: 58ch; }
  .muted { color: var(--ink-2); }

  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.9rem 0; }
  .button { background: linear-gradient(175deg, #7c5cff, var(--violet)); border: 0; border-radius: var(--r-pill); box-shadow: var(--shadow-violet); color: #fff; display: inline-block; font-size: .92rem; font-weight: 700; padding: .85rem 1.5rem; text-decoration: none; transition: box-shadow .18s ease, transform .18s ease, filter .18s ease; }
  .button:hover { box-shadow: 0 1rem 2.2rem -.6rem rgba(109, 74, 255, .6); filter: brightness(1.07); transform: translateY(-1px); }
  .button:active { transform: translateY(0); }
  .button.secondary { background: var(--panel); box-shadow: inset 0 0 0 1px var(--violet-line), var(--shadow-sm); color: var(--violet-deep); }
  .button.secondary:hover { background: var(--violet-soft); box-shadow: inset 0 0 0 1px var(--violet); filter: none; }
  .text-link { color: var(--violet-deep); font-weight: 700; text-decoration: none; }
  .text-link:hover { text-decoration: underline; }
  .text-link span { display: inline-block; margin-left: .3rem; transition: transform .18s ease; }
  .text-link:hover span { transform: translateX(.2rem); }

  .grid { display: grid; gap: .9rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 2.5rem 0; }
  .card, .notice { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r-md); padding: 1.5rem; }
  .card strong { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.02em; }
  .notice { background: #fff8ef; border-color: #f3dfc2; border-left: .3rem solid var(--warn); }
  code { background: var(--violet-soft); border-radius: .25rem; color: var(--violet-ink); font-family: var(--font-mono); font-size: .88em; padding: .12rem .35rem; word-break: break-word; }
  pre { background: var(--night); border: 1px solid var(--night-line); border-radius: var(--r-md); color: var(--night-ink); max-width: 100%; overflow-x: auto; padding: 1.4rem; }
  pre code { background: transparent; color: inherit; padding: 0; white-space: pre; }

  table { border-collapse: collapse; min-width: 42rem; width: 100%; }
  th, td { border-bottom: 1px solid var(--line); padding: .9rem; text-align: left; vertical-align: top; }
  th { background: var(--violet-soft); color: var(--violet-ink); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .09em; text-transform: uppercase; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  ul, ol { max-width: 68ch; padding-left: 1.2rem; }
  li + li { margin-top: .5rem; }
  ::marker { color: var(--violet); }

  .legal h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .content-body { display: grid; gap: 3.5rem; margin-top: 3.5rem; }
  .content-section { display: grid; gap: .65rem 2rem; grid-template-columns: minmax(12rem, .6fr) minmax(0, 1.4fr); }
  .content-section > div > :first-child, .content-section > :first-child { margin-top: 0; }
  .content-section h2 { font-size: clamp(1.7rem, 2.6vw, 2.4rem); position: sticky; top: 5.5rem; }
  .content-section-copy > *:first-child { margin-top: 0; }
  .content-section-copy > *:last-child { margin-bottom: 0; }

  .fact-strip { border: 1px solid var(--violet-line); border-radius: var(--r-md); display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); margin: 2rem 0; overflow: hidden; }
  .fact-strip > div { background: var(--violet-soft); padding: 1.3rem 1.4rem; }
  .fact-strip > div + div { box-shadow: inset 1px 0 0 var(--violet-line); }
  .fact-strip strong { color: var(--violet-ink); display: block; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -.03em; }
  .fact-strip span { color: var(--ink-2); font-size: .8rem; }
  .callout { background: var(--violet-soft); border-left: .3rem solid var(--violet); border-radius: 0 var(--r-md) var(--r-md) 0; margin: 2rem 0; padding: 1.3rem 1.5rem; }
  .source-list { color: var(--ink-2); font-size: .84rem; }

  @media (max-width: 60rem) {
    .content-section h2 { position: static; }
    .footer-cols { grid-template-columns: repeat(3, 1fr); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 54rem) {
    /* Below this width the pill would eat the viewport: use a plain sticky bar,
       which sits in the flow and needs no clearance. */
    :root { --header-h: 0rem; }
    .site-header { border-radius: 0; border-left: 0; border-right: 0; border-top: 0; box-shadow: none; gap: .6rem; grid-template-columns: 1fr auto; left: auto; padding: .75rem var(--gutter); position: sticky; top: 0; transform: none; width: 100%; }
    .main-nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; order: 3; }
    .content-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    :root { --r-panel: 1.35rem; }
    .brand span { display: none; }
    .footer-cols { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
    table { min-width: 34rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
