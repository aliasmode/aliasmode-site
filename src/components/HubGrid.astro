---
import { requireSiteRoute, type RouteKind } from '../data/site-routes';

interface Props { paths: string[] }
const { paths } = Astro.props;
const routes = paths.map((path) => requireSiteRoute(path, `${Astro.url.pathname} hub grid`));
const kindLabel: Record<RouteKind, string> = {
  home: 'Home',
  product: 'Product',
  company: 'Company',
  documentation: 'Docs',
  comparison: 'Comparison',
  ranking: 'Ranking',
  integration: 'Integration',
  'use-case': 'Use case',
  guide: 'Guide',
  tool: 'Tool',
  article: 'Article',
  legal: 'Legal',
};
---
<div class="hub-grid">
  {routes.map((route) => (
    <a href={route.path}>
      <span class="kind">{kindLabel[route.kind]}</span>
      <strong>{route.label}</strong>
      <p>{route.description}</p>
      <span class="open">Open <i aria-hidden="true">→</i></span>
    </a>
  ))}
</div>

<style>
  .hub-grid { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin: 1.6rem 0 0; }
  .hub-grid a { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r-md); display: flex; flex-direction: column; min-height: 13rem; padding: 1.5rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .hub-grid a:hover { border-color: var(--violet-line); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .hub-grid .kind { color: var(--violet); font: 700 .66rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .hub-grid strong { color: var(--ink); font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -.03em; line-height: 1.15; margin-top: 1rem; }
  .hub-grid p { color: var(--ink-2); font-size: .88rem; margin: .5rem 0 0; }
  .hub-grid .open { color: var(--violet-deep); font-size: .84rem; font-weight: 700; margin-top: auto; padding-top: 1.2rem; }
  .hub-grid .open i { display: inline-block; font-style: normal; transition: transform .16s ease; }
  .hub-grid a:hover .open i { transform: translateX(.25rem); }
  @media (prefers-reduced-motion: reduce) { .hub-grid a, .hub-grid .open i { transition: none; } }
</style>
