---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
import GitHubButton from '../components/GitHubButton.astro';
import TelegramButton from '../components/TelegramButton.astro';
import { siteConfig } from '../../site.config.mjs';
import PricingPlans from '../components/PricingPlans.astro';
import DetectionTable from '../components/DetectionTable.astro';

const profiles = [
  { initial: 'A', name: 'Agency workspace', fingerprint: 'UTC+01:00 · en-GB · Iris Xe', state: 'Synced', tint: 'violet', lift: 8 },
  { initial: 'S', name: 'Storefront', fingerprint: 'UTC−05:00 · en-US · RTX 3060', state: 'Synced', tint: 'teal', lift: 14 },
  { initial: 'C', name: 'Client account', fingerprint: 'UTC+08:00 · en-SG · Mali-G78', state: 'Open', tint: 'night', lift: 20 },
];

const tabs = [
  { id: 'profiles', label: 'All profiles', count: '3' },
  { id: 'team', label: 'Team', count: '4' },
  { id: 'trash', label: 'Trash', count: '2' },
];

const team = [
  { initial: 'AM', name: 'Ava Mendes', access: 'All profiles · 2 devices', role: 'Owner', tint: 'violet' },
  { initial: 'JD', name: 'Jonas Dahl', access: 'Client work · 1 device', role: 'Member', tint: 'teal' },
  { initial: 'RK', name: 'Rina Kapoor', access: 'Storefront only · 1 device', role: 'Member', tint: 'night' },
];

const trash = [
  { initial: 'B', name: 'Beta test profile', deleted: 'Deleted 2 days ago' },
  { initial: 'O', name: 'Old storefront', deleted: 'Deleted 9 days ago' },
];

const surfaces = 'COOKIES · LOCAL STORAGE · INDEXEDDB · TIMEZONE · LANGUAGE · WEBGL RENDERER · SCREEN METRICS · CANVAS · FONTS · PROXY · '.repeat(3);
const promise = 'UNLIMITED PROFILES · ZERO COST FOREVER · APACHE-2.0 · NO PROFILE FEES · '.repeat(3);

const chatTopics = ['Release notes', 'Fingerprint questions', 'Proxy setup', 'Local API', 'Bug reports', 'Feature requests'];

const pathways = [
  { kind: 'Agency operations', title: 'Separate client sessions and team handoffs.', href: '/agencies/', cta: 'AliasMode for agencies' },
  { kind: 'Product evaluation', title: 'Compare price, source, Local, Cloud, and APIs.', href: '/alternatives/', cta: 'Browse alternatives' },
  { kind: 'AI agents', title: 'Browse without bot walls over CDP.', href: '/use-cases/ai-agents/', cta: 'Run AI agents on AliasMode' },
  { kind: 'Proxy setup', title: 'Configure HTTP, HTTPS, and SOCKS5 per profile.', href: '/docs/proxies/', cta: 'Read proxy documentation' },
  { kind: 'Documentation', title: 'Install, create profiles, troubleshoot, and automate.', href: '/docs/', cta: 'Open the docs' },
];
---
<BaseLayout
  layout="sections"
  title="Free Open-Source Antidetect Browser"
  description="AliasMode is a free, open-source antidetect browser for managing multiple accounts. Create unlimited profiles, sync across devices, and work with your team."
>
  <section class="surface hero-surface">
    <div class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Free &amp; open source · Windows beta</p>
        <h1>The free, open-source <span>antidetect browser</span> for managing multiple accounts.</h1>
        <p class="lead">Create unlimited isolated browser profiles, sync them across your devices, and collaborate with your team or your AI agents from one workspace.</p>
        <div class="actions">
          <a class="button" href="/download/" data-track-cta data-cta-type="cloud-signup" data-page-group="home" data-destination="download">Download &amp; sign up free</a>
          <GitHubButton href="https://github.com/aliasmode/aliasmode" label="View on GitHub" tone="outline" track pageGroup="home" />
        </div>
        <p class="hero-note"><a href="/local/">Prefer no account? Use Local mode.</a></p>
      </div>

      <div class="stage">
        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs><path id="seal-ring" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
            <text><textPath href="#seal-ring" textLength="276" lengthAdjust="spacing">FREE · OPEN SOURCE · UNLIMITED PROFILES · </textPath></text>
          </svg>
          <span class="seal-core">∞</span>
        </div>
        <div class="deck">
          <div class="deck-inner">
            <div class="ground" aria-hidden="true"></div>
            <div class="app">
              <div class="app-edge" aria-hidden="true"></div>
              <div class="app-bar"><span></span><span></span><span></span><b>AliasMode</b></div>
              <div class="app-body">
                <aside role="tablist" aria-label="AliasMode workspace" aria-orientation="vertical">
                  <span class="side-label">Workspace</span>
                  {tabs.map((tab, index) => (
                    <button
                      type="button"
                      role="tab"
                      id={`am-tab-${tab.id}`}
                      class:list={['side-item', { 'is-active': index === 0 }]}
                      aria-controls={`am-panel-${tab.id}`}
                      aria-selected={index === 0 ? 'true' : 'false'}
                      tabindex={index === 0 ? 0 : -1}
                      data-tab={tab.id}
                    >{tab.label}<i aria-hidden="true">{tab.count}</i></button>
                  ))}
                </aside>

                <div class="board">
                  <div class="board-panel" id="am-panel-profiles" role="tabpanel" aria-labelledby="am-tab-profiles" data-panel="profiles">
                    <div class="board-head">
                      <strong>Browser profiles</strong>
                      <span class="board-new">+ New</span>
                    </div>
                    {profiles.map((profile) => (
                      <div class="prow" style={`--lift: ${profile.lift}px`}>
                        <span class:list={['prow-icon', profile.tint]}>{profile.initial}</span>
                        <div class="prow-text">
                          <strong>{profile.name}</strong>
                          <small>{profile.fingerprint}</small>
                        </div>
                        <span class:list={['prow-state', { open: profile.state === 'Open' }]}>{profile.state}</span>
                      </div>
                    ))}
                    <p class="board-note">Each profile carries its own timezone, language and hardware fingerprint.</p>
                  </div>

                  <div class="board-panel" id="am-panel-team" role="tabpanel" aria-labelledby="am-tab-team" data-panel="team" hidden>
                    <div class="board-head">
                      <strong>Team</strong>
                      <span class="board-new">+ Invite</span>
                    </div>
                    {team.map((member, index) => (
                      <div class="prow" style={`--lift: ${10 + index * 6}px`}>
                        <span class:list={['prow-icon', member.tint]}>{member.initial}</span>
                        <div class="prow-text">
                          <strong>{member.name}</strong>
                          <small>{member.access}</small>
                        </div>
                        <span class:list={['prow-state', { open: member.role === 'Owner' }]}>{member.role}</span>
                      </div>
                    ))}
                    <p class="board-note">One workspace, owner and member roles, revoke a device at any time.</p>
                  </div>

                  <div class="board-panel" id="am-panel-trash" role="tabpanel" aria-labelledby="am-tab-trash" data-panel="trash" hidden>
                    <div class="board-head">
                      <strong>Trash</strong>
                      <span class="board-new muted-new">Empty</span>
                    </div>
                    {trash.map((item, index) => (
                      <div class="prow is-dim" style={`--lift: ${10 + index * 6}px`}>
                        <span class="prow-icon night">{item.initial}</span>
                        <div class="prow-text">
                          <strong>{item.name}</strong>
                          <small>{item.deleted}</small>
                        </div>
                        <span class="prow-state restore">Restore</span>
                      </div>
                    ))}
                    <p class="board-note">Deleted profiles stay recoverable until you empty the trash.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ul class="spec-rail" aria-label="At a glance">
      <li><b>∞</b> profiles, no fees</li>
      <li><b>$0</b> forever</li>
      <li><b>Apache-2.0</b> desktop client</li>
      <li><b>Cloud</b> sync and teams</li>
    </ul>
  </section>

  <section class="surface surface-tint" id="features">
    <div class="section-head">
      <p class="eyebrow">One browser. Every account.</p>
      <h2>Manage more accounts without paying more.</h2>
      <p class="lead">Give every account its own browser identity, then keep your work organized across devices and teammates.</p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="13" height="13" rx="3.2"/><path d="M8 21h9a4 4 0 0 0 4-4V8"/></svg></span>
        <h3>Unlimited profiles</h3>
        <p>Create a separate profile for every account, client, brand, or project. Add as many as your work needs.</p>
      </article>
      <article class="feature-card featured">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="12" r="4"/><circle cx="17" cy="12" r="4"/><path d="M12 3v18"/></svg></span>
        <h3>Isolated identities</h3>
        <p>Each profile keeps its own browser identity, cookies, sessions, and storage so your accounts stay separate.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 18a4.5 4.5 0 0 1-.4-9A6 6 0 0 1 17.7 8a4 4 0 0 1 .3 8"/><path d="M12 21v-8m0 0-2.5 2.5M12 13l2.5 2.5"/></svg></span>
        <h3>Cloud teamwork</h3>
        <p>Sync encrypted portable profiles, invite teammates, and work together, people and AI agents, through one shared workspace.</p>
      </article>
    </div>
  </section>

  <section class="ribbons" aria-hidden="true">
    <div class="ribbon ribbon-a">
      <div class="ribbon-track">
        <span>{surfaces}</span><span>{surfaces}</span>
      </div>
    </div>
    <div class="ribbon ribbon-b">
      <div class="ribbon-track">
        <span>{promise}</span><span>{promise}</span>
      </div>
    </div>
  </section>

  <section class="surface surface-light">
    <DetectionTable
      eyebrow="Detection-tested runtime"
      heading="Passes the bot checks real platforms use."
      lead="Every AliasMode profile opens in CloakBrowser, a Chrome-based runtime patched at the source, so websites see a normal human-driven browser, not an automation tool. Here is how it compares on the public detection services that platforms use to screen visitors."
    />
  </section>

  <section class="surface surface-dark workflow">
    <div class="workflow-copy">
      <p class="eyebrow">Start in minutes</p>
      <h2>Download. Create. Sync. Share.</h2>
      <p>Install AliasMode on Windows and create your free Cloud account inside the app. Your profiles are ready when your work moves to another device or teammate.</p>
      <a class="text-link" href="/download/" data-track-cta data-cta-type="download" data-page-group="home-workflow" data-destination="download">Get AliasMode free <span>→</span></a>
    </div>
    <ol class="workflow-steps">
      <li><span>1</span><div><strong>Download AliasMode</strong><small>Install the Windows beta.</small></div></li>
      <li><span>2</span><div><strong>Create your free account</strong><small>Choose Cloud inside the app.</small></div></li>
      <li><span>3</span><div><strong>Build your profiles</strong><small>Keep every account separate.</small></div></li>
      <li><span>4</span><div><strong>Sync or invite</strong><small>Move across devices or add your team.</small></div></li>
    </ol>
  </section>

  <section class="surface surface-light api-section" id="api">
    <div class="api-copy">
      <p class="eyebrow">Browser automation API</p>
      <h2>Automate profiles with the tools you already use.</h2>
      <p>Open profiles through an AdsPower-compatible local API, then automate them over Playwright CDP. Your AI agents connect to the same endpoint.</p>
      <ul>
        <li>Start and stop browser profiles through HTTP.</li>
        <li>Check profile and service status programmatically.</li>
        <li>Connect Playwright directly to the running browser over CDP.</li>
        <li>Run AI browser agents on profiles that pass the bot checks blocking stock automated browsers.</li>
      </ul>
      <div class="actions"><a class="button" href="/docs/local-api/">Read the Local API</a><a class="button secondary" href="/integrations/playwright/">Use Playwright</a></div>
    </div>
    <div class="terminal" aria-label="Starting a profile and attaching Playwright">
      <div class="terminal-bar"><span></span><span></span><span></span><b>automation.js</b></div>
      <pre><code><i>// start the profile</i>
<b>GET</b> <u>/api/v1/browser/start</u>?user_id=<em>PROFILE_ID</em>

<i>// attach to what is already running</i>
<b>const</b> browser = <b>await</b> chromium.connectOverCDP(
  res.data.ws.puppeteer
)</code></pre>
    </div>
  </section>

  <section class="surface surface-tint">
    <div class="split">
      <div class="split-card">
        <p class="eyebrow">Open by default</p>
        <h2>Built in the open.</h2>
        <p>The AliasMode desktop client is Apache-2.0 open source. Read the code, follow releases, report issues, and contribute directly. CloakBrowser installs separately under its own license, and AliasMode Cloud is a managed service.</p>
        <GitHubButton href="https://github.com/aliasmode/aliasmode" label="aliasmode/aliasmode" track pageGroup="home" />
      </div>
      <div class="split-card split-warm">
        <p class="eyebrow">Local mode</p>
        <h2>Want to work without an account?</h2>
        <p>Use AliasMode Local. Your profile data stays on that computer and AliasMode sends no traffic to Cloud.</p>
        <a class="text-link" href="/local/">Explore account-free Local mode <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="surface surface-light">
    <div class="section-head">
      <p class="eyebrow">Built for real account work</p>
      <h2>Move from profiles to a repeatable workflow.</h2>
    </div>
    <ul class="link-index">
      {pathways.map((item) => (
        <li>
          <a href={item.href}>
            <span class="li-kind">{item.kind}</span>
            <span class="li-title">{item.title}</span>
            <span class="li-go">{item.cta} <i aria-hidden="true">→</i></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="surface surface-tint maker">
    <p class="eyebrow">Developed by Xreacher</p>
    <h2>Built for real multi-account operations.</h2>
    <p>The Xreacher team developed AliasMode for its own work and used it internally for months before releasing it as a free, open-source product.</p>
    <a class="text-link" href="/about/">Read the AliasMode story <span>→</span></a>
  </section>

  <section class="surface surface-dark community" id="community">
    <div class="community-copy">
      <p class="eyebrow">Community</p>
      <h2>Bring your questions to the group.</h2>
      <p>Releases, fingerprint questions, proxy troubleshooting and feature requests all land in one open Telegram group, read by the people building AliasMode.</p>
      <div class="actions">
        <TelegramButton href={siteConfig.telegramCommunity} label="Join the Telegram group" />
        <GitHubButton href={siteConfig.githubRepository} label="Report an issue" tone="light" track pageGroup="home" ctaType="github-issue" />
      </div>
      <p class="community-note">Free to join, and open to read before you post.</p>
    </div>

    <div class="group-card" aria-hidden="true">
      <div class="group-top">
        <span class="group-avatar"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42Z"/></svg></span>
        <span class="group-id"><strong>AliasMode</strong><small>t.me/aliasmode</small></span>
      </div>
      <p class="group-line">What people talk about here</p>
      <ul class="group-chips">
        {chatTopics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
  </section>

  <section class="surface surface-light" id="pricing">
    <div class="section-head">
      <p class="eyebrow">Simple pricing</p>
      <h2>Every feature is <span class="marked">free<svg viewBox="0 0 220 18" aria-hidden="true"><path d="M4 12.5c38-7 84-9.5 128-8 26 .9 52 3.4 84 7" /></svg></span>.</h2>
      <p class="lead">Choose Cloud or Local at no cost. AliasMode is a non-profit project supported by optional donations.</p>
    </div>
    <PricingPlans />
  </section>

  <section class="surface surface-tint">
    <DownloadPanel />
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const tabs = Array.from(document.querySelectorAll('[data-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-panel]'));
    if (!tabs.length || !panels.length) return;
    const select = (id, focus) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.tab, false));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowDown' ? 1 : event.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length].dataset.tab, true);
      });
    });
  })();
</script>

<style>
  /* ------------------------------------------------------------------ Hero */
  .hero-surface { background: linear-gradient(163deg, #f2ecff 0%, #f7f0fb 48%, #fdefe6 100%); padding-bottom: 0; padding-top: calc(var(--header-h) + clamp(2rem, 4vw, 3.25rem)); }
  .hero { align-items: center; display: grid; gap: clamp(2rem, 4vw, 3.5rem); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .hero h1 { font-size: clamp(2.5rem, 3.9vw, 3.9rem); max-width: 16ch; }
  .hero h1 span { background: linear-gradient(96deg, var(--violet) 5%, #9b5cf0 48%, #e2673f 100%); -webkit-background-clip: text; background-clip: text; -webkit-box-decoration-break: clone; box-decoration-break: clone; color: transparent; padding-right: .06em; }
  .hero .lead { max-width: 44ch; }
  .hero-note { margin: -.5rem 0 0; }
  .hero-note a { color: var(--ink-2); font-size: .88rem; text-decoration-color: var(--violet-line); }
  .hero-note a:hover { color: var(--violet-deep); }

  /* --------------------------------- The workspace, standing in real 3D space */
  .stage { --u: 1; height: 33rem; perspective: 1300px; perspective-origin: 58% 44%; position: relative; }
  .deck { inset: 0; position: absolute; transform: rotateX(var(--hx, 3deg)) rotateY(var(--hy, -8deg)); transform-style: preserve-3d; transition: transform .6s cubic-bezier(.22, .7, .3, 1); }
  .deck-inner { animation: drift 13s ease-in-out infinite alternate; height: 100%; position: relative; transform-style: preserve-3d; }
  @keyframes drift {
    from { transform: rotateY(-1.6deg) translateZ(0); }
    to { transform: rotateY(1.6deg) translateZ(14px); }
  }
  /* Hovering settles the mock face-on so it is comfortable to read and click. */
  .stage:hover .deck, .stage:focus-within .deck { --hx: 1deg; --hy: -2.5deg; }
  .stage:hover .deck-inner, .stage:focus-within .deck-inner { animation-play-state: paused; }


  /* Load-in: the hero settles rather than snapping into place. */
  @keyframes rise { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  .hero-copy > * { animation: rise .7s cubic-bezier(.2, .7, .3, 1) backwards; }
  .hero-copy > *:nth-child(1) { animation-delay: .04s; }
  .hero-copy > *:nth-child(2) { animation-delay: .1s; }
  .hero-copy > *:nth-child(3) { animation-delay: .17s; }
  .hero-copy > *:nth-child(4) { animation-delay: .24s; }
  .hero-copy > *:nth-child(5) { animation-delay: .3s; }
  .stage { animation: fade .9s ease .22s backwards; }
  .spec-rail { animation: rise .7s cubic-bezier(.2, .7, .3, 1) .36s backwards; }

  /* Scroll reveal where the browser supports it, ignored everywhere else. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .surface:not(.hero-surface) > *, .split-card {
        animation: rise linear both;
        animation-range: entry 4% cover 20%;
        animation-timeline: view();
      }
    }
  }

  .ground { background: radial-gradient(closest-side, rgba(76, 40, 190, .34), rgba(76, 40, 190, 0) 74%); height: calc(300px * var(--u)); max-width: 100%; left: 50%; position: absolute; top: 50%; transform: translate(-50%, -50%) translate3d(0, calc(215px * var(--u)), calc(-70px * var(--u))) rotateX(80deg); width: calc(520px * var(--u)); }

  /* Nothing on this chain may use overflow: hidden — it flattens preserve-3d. */
  .app { left: 50%; position: absolute; top: 50%; transform: translate(-50%, -50%); transform-style: preserve-3d; transition: transform .6s cubic-bezier(.22, .7, .3, 1); width: calc(486px * var(--u)); }
  .stage:hover .app, .stage:focus-within .app { transform: translate(-50%, -50%) translateZ(calc(26px * var(--u))); }
  /* Extruded back plate: what makes the window read as an object, not a picture. */
  .app-edge { background: linear-gradient(150deg, #2a2350, #14111f); border-radius: calc(18px * var(--u)); box-shadow: 0 calc(46px * var(--u)) calc(70px * var(--u)) calc(-24px * var(--u)) rgba(24, 8, 66, .62); inset: calc(-1px * var(--u)); position: absolute; transform: translateZ(calc(-15px * var(--u))); }

  .app-bar { align-items: center; background: linear-gradient(180deg, #221c3c, var(--night)); border: 1px solid rgba(160, 132, 255, .22); border-bottom: 0; border-radius: calc(17px * var(--u)) calc(17px * var(--u)) 0 0; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .07); display: flex; gap: calc(6px * var(--u)); height: calc(40px * var(--u)); padding: 0 calc(15px * var(--u)); position: relative; }
  .app-bar span { background: var(--night-3); border-radius: 50%; height: calc(7px * var(--u)); width: calc(7px * var(--u)); }
  .app-bar span:first-child { background: var(--violet); box-shadow: 0 0 calc(9px * var(--u)) rgba(124, 92, 255, .8); }
  .app-bar b { color: var(--night-ink-2); font: 600 calc(10px * var(--u))/1 var(--font-mono); margin-left: auto; }
  .app-body { display: grid; grid-template-columns: calc(132px * var(--u)) minmax(0, 1fr); position: relative; transform-style: preserve-3d; }

