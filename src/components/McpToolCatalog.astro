---
import currentSource from '../data/generated/mcp-tools/current-source.json';
import { published } from '../data/release';
import { slugify } from './format';

/**
 * MCP tool catalog for the published installer version. Falls back to the
 * current-source catalog when no versioned catalog exists for the release.
 */
type Dict = Record<string, any>;
interface Tool { name: string; description?: string; annotations?: Dict; inputSchema?: Dict }
interface Catalog {
  catalogSchemaVersion?: number;
  aliasModeVersion?: string;
  status?: string;
  sourceRef?: string;
  playwrightMcpVersion?: string;
  playwrightCapabilities?: string[];
  filteredPlaywrightTools?: string[];
  playwrightToolAvailability?: unknown;
  aliasModeTools?: Tool[];
  playwrightTools?: Tool[];
}

const catalogs = import.meta.glob<Catalog>('../data/generated/mcp-tools/*.json', { eager: true, import: 'default' });
const version = published?.version;
const released = version ? catalogs[`../data/generated/mcp-tools/${version}.json`] : undefined;
const source = currentSource as Catalog;
const catalog: Catalog = released ?? source;
const catalogVersion = catalog.aliasModeVersion ?? version ?? 'current source';

const toolNames = (list?: Tool[]) => (list ?? []).map((tool) => tool.name);
const releasedNames = new Set([...toolNames(catalog.aliasModeTools), ...toolNames(catalog.playwrightTools)]);
const onlyInSource = released ? [...toolNames(source.aliasModeTools), ...toolNames(source.playwrightTools)].filter((name) => !releasedNames.has(name)) : [];

const hintLabels: [string, string][] = [['readOnlyHint', 'read-only'], ['destructiveHint', 'destructive'], ['idempotentHint', 'idempotent'], ['openWorldHint', 'open world']];
const chipsOf = (annotations?: Dict) => hintLabels.filter(([key]) => annotations?.[key] === true).map(([, label]) => label);
const schemaOf = (tool: Tool) => (tool.inputSchema ? JSON.stringify(tool.inputSchema, null, 2) : undefined);

const groups = [
  { id: 'aliasmode-tools', title: 'AliasMode tools', note: 'Profile and browser lifecycle tools that AliasMode adds in front of Playwright MCP.', tools: catalog.aliasModeTools ?? [] },
  { id: 'playwright-tools', title: 'Playwright tools', note: `Browser tools from Playwright MCP${catalog.playwrightMcpVersion ? ` ${catalog.playwrightMcpVersion}` : ''}, run inside the selected AliasMode profile.`, tools: catalog.playwrightTools ?? [] },
];
const capabilities = Array.isArray(catalog.playwrightCapabilities) ? catalog.playwrightCapabilities : [];
const filtered = Array.isArray(catalog.filteredPlaywrightTools) ? catalog.filteredPlaywrightTools : [];
---
<div class="mcp-catalog">
  <div class="catalog-banner">
    <p class="eyebrow">Tool catalog</p>
    <p class="banner-line">
      <b>Catalog for installer {catalogVersion}</b>
      {catalog.status && <span class:list={['chip', { live: catalog.status === 'released' }]}>{catalog.status}</span>}
      {catalog.playwrightMcpVersion && <span class="chip">Playwright MCP {catalog.playwrightMcpVersion}</span>}
      {catalog.sourceRef && <code>{catalog.sourceRef}</code>}
    </p>
    {capabilities.length > 0 && <p class="banner-meta">Playwright capabilities: {capabilities.join(', ')}</p>}
    {filtered.length > 0 && <p class="banner-meta">Filtered out of the Playwright set: {filtered.join(', ')}</p>}
  </div>

  {groups.map((group) => (
    <section class="tool-group" aria-labelledby={group.id}>
      <h3 id={group.id}>{group.title} <span class="count">{group.tools.length}</span></h3>
      <p class="muted">{group.note}</p>
      {group.tools.length > 0 ? (
        <div class="tool-list">
          {group.tools.map((tool) => (
            <article class="tool" id={`tool-${slugify(tool.name)}`}>
              <div class="tool-head">
                <h4><code>{tool.name}</code></h4>
                {typeof tool.annotations?.title === 'string' && <span class="tool-title">{tool.annotations.title}</span>}
                {chipsOf(tool.annotations).map((chip) => <span class="chip">{chip}</span>)}
              </div>
              {tool.description && <p>{tool.description}</p>}
              {schemaOf(tool) && (
                <details>
                  <summary>Input schema</summary>
                  <pre tabindex="0" role="region" aria-label="Input schema, scrollable horizontally"><code>{schemaOf(tool)}</code></pre>
                </details>
              )}
            </article>
          ))}
        </div>
      ) : <p class="muted">No tools are listed in this catalog.</p>}
    </section>
  ))}

  {released && (
    <section class="source-diff" aria-labelledby="source-diff-title">
      <p class="eyebrow">Secondary</p>
      <h3 id="source-diff-title">Current source differences</h3>
      <p class="muted">Tools in the current source tree{source.sourceRef ? ` (${source.sourceRef})` : ''} that the {catalogVersion} installer does not ship yet.</p>
      {onlyInSource.length > 0 ? (
        <ul class="chip-list">{onlyInSource.map((name) => <li><code>{name}</code></li>)}</ul>
      ) : <p class="muted">No differences. The installer catalog matches the current source.</p>}
    </section>
  )}
</div>

<style>
  .mcp-catalog { min-width: 0; }
  .catalog-banner { background: linear-gradient(150deg, var(--night), #241d47); border-radius: var(--r-md); color: #fff; margin-bottom: 1.8rem; padding: 1.2rem 1.4rem; }
  .catalog-banner .eyebrow { color: #b7a1ff; margin: 0 0 .5rem; }
  .banner-line { align-items: center; display: flex; flex-wrap: wrap; gap: .55rem; margin: 0; max-width: none; }
  .banner-line b { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: -.02em; }
  .banner-line code { background: rgba(255, 255, 255, .1); color: var(--night-ink); font-size: .74rem; }
  .banner-meta { color: var(--night-ink-2); font-size: .8rem; margin: .6rem 0 0; max-width: none; }
  .chip { background: var(--violet-soft); border-radius: var(--r-pill); color: var(--violet-ink); font: 700 .64rem/1 var(--font-mono); padding: .35rem .6rem; white-space: nowrap; }
  .catalog-banner .chip { background: rgba(255, 255, 255, .12); color: #fff; }
  .catalog-banner .chip.live { background: rgba(111, 224, 212, .18); color: #6fe0d4; }

  .tool-group + .tool-group, .source-diff { margin-top: 2.5rem; }
  .tool-group > h3, .source-diff > h3 { border-bottom: 1px solid var(--line); font-size: 1.3rem; padding-bottom: .5rem; }
  .count { background: var(--violet-soft); border-radius: var(--r-pill); color: var(--violet-ink); font: 700 .7rem/1 var(--font-mono); margin-left: .4rem; padding: .3rem .55rem; vertical-align: middle; }
  .tool-list { display: grid; gap: .8rem; margin-top: 1rem; }
  .tool { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-md); padding: 1.1rem 1.3rem; }
  .tool-head { align-items: center; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tool-head h4 { font-size: 1rem; margin: 0; }
  .tool-head h4 code { background: var(--night); color: #ded6f8; font-size: .82rem; padding: .3rem .55rem; }
  .tool-title { color: var(--ink-2); font-size: .85rem; font-weight: 600; }
  .tool > p { color: var(--ink-2); font-size: .9rem; margin: .7rem 0 0; }
  .tool details { margin-top: .8rem; }
  .tool summary { color: var(--violet-deep); cursor: pointer; font-size: .82rem; font-weight: 700; }
  .tool summary:hover { text-decoration: underline; }
  .tool pre { font-size: .76rem; margin: .6rem 0 0; padding: 1rem; }
  .source-diff .eyebrow { color: var(--ink-3); margin-bottom: .2rem; }
  .chip-list { display: flex; flex-wrap: wrap; gap: .45rem; list-style: none; margin: .8rem 0 0; max-width: none; padding: 0; }
  .chip-list li { margin: 0; }
</style>
