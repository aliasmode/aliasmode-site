---
import { getSiteRoute } from '../data/site-routes';
import type { SiteRoute } from '../data/site-routes';

interface Props { paths: string[] }
const { paths } = Astro.props;
const routes = paths.map(getSiteRoute).filter(Boolean);
---
<div class="hub-grid">
  {routes.map((route: SiteRoute | undefined) => route && (
    <a href={route.path}>
      <span class="kind">{route.kind}</span>
      <strong>{route.label}</strong>
      <p>{route.description}</p>
      <span class="open">Open →</span>
    </a>
  ))}
</div>

<style>
  .hub-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); margin: 3rem 0; }
  .hub-grid a { background: linear-gradient(180deg, rgba(139, 167, 255, .05), rgba(139, 167, 255, .015)); border: 1px solid var(--line); border-radius: .8rem; display: flex; flex-direction: column; min-height: 15rem; padding: 1.5rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .hub-grid a:hover { border-color: var(--accent); box-shadow: 0 0 2rem rgba(49, 184, 199, .12); transform: translateY(-3px); }
  .hub-grid .kind { color: var(--accent); font: 700 .67rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .hub-grid strong { color: var(--ink); font-family: var(--font-display); font-size: 1.25rem; margin-top: 1.2rem; }
  .hub-grid p { color: var(--muted); font-size: .9rem; }
  .hub-grid .open { color: var(--accent-bright); font-size: .85rem; font-weight: 700; margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .hub-grid a { transition: none; } }
</style>
