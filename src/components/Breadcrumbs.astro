---
import type { SiteRoute } from '../data/site-routes';
import { getBreadcrumbs } from '../data/site-routes';

interface Props { route: SiteRoute }
const { route } = Astro.props;
const crumbs = getBreadcrumbs(route);
---
{crumbs.length > 1 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb" data-breadcrumbs>
    <ol>
      {crumbs.map((crumb, index) => (
        <li>
          {index === crumbs.length - 1
            ? <span aria-current="page">{crumb.label}</span>
            : <a href={crumb.path}>{crumb.label}</a>}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs { font-size: .78rem; margin-bottom: 2rem; }
  .breadcrumbs ol { align-items: center; display: flex; flex-wrap: wrap; gap: .45rem; list-style: none; margin: 0; padding: 0; }
  .breadcrumbs li { align-items: center; color: var(--ink-2); display: flex; margin: 0; }
  .breadcrumbs li + li::before { color: var(--violet-line); content: '/'; margin-right: .45rem; }
  .breadcrumbs a { font-weight: 650; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--violet-deep); text-decoration: underline; }
  .breadcrumbs span { color: var(--ink); }
</style>
