---
import type { CtaType } from '../data/content/types';

interface Props {
  href: string;
  label: string;
  type: CtaType;
  class?: string;
  destination?: string;
  campaign?: string;
}
const { href, label, type, class: className = 'button', destination, campaign } = Astro.props;
const external = /^https?:\/\//.test(href);
const resolvedDestination = destination ?? (href.startsWith('https://xreacher.com') ? 'xreacher' : href.startsWith('https://github.com') ? 'github' : 'aliasmode');
---
<a
  href={href}
  class={className}
  rel={external ? 'noopener' : undefined}
  data-track-cta
  data-cta-type={type}
  data-destination={resolvedDestination}
  data-campaign={campaign}
>{label}</a>
