---
import { siteConfig } from '../../site.config.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GitHubButton from '../components/GitHubButton.astro';
import { canonicalPath, getBreadcrumbs, getSiteRoute } from '../data/site-routes';

interface Props { title?: string; description?: string; noIndex?: boolean; canonical?: boolean }
const {
  title = 'Free Open-Source Antidetect Browser',
  description = 'AliasMode is a free, open-source antidetect browser for managing multiple accounts.',
  noIndex = false,
  canonical: includeCanonical = true,
} = Astro.props;
const route = getSiteRoute(Astro.url.pathname);
const routePath = route?.path ?? canonicalPath(Astro.url.pathname);
const resolvedTitle = route?.title ?? title;
const resolvedDescription = route?.description ?? description;
const fullTitle = `${resolvedTitle} · AliasMode`;
const shouldIndex = siteConfig.index && !noIndex;
const canonical = shouldIndex && includeCanonical ? new URL(routePath, siteConfig.origin).toString() : undefined;
const metadataUrl = new URL(routePath, siteConfig.metadataOrigin).toString();
const socialImage = new URL('/social/aliasmode-open-source-antidetect-browser.png', siteConfig.metadataOrigin).toString();
const breadcrumbs = route ? getBreadcrumbs(route) : [];
const organizationId = `${siteConfig.metadataOrigin}/#organization`;
const schemas: Record<string, unknown>[] = [];

if (route) {
  schemas.push({
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Xreacher',
    url: 'https://xreacher.com/',
    brand: { '@type': 'Brand', name: 'AliasMode', url: siteConfig.metadataOrigin },
  });
}
if (route?.kind === 'home') {
  schemas.push({
    '@type': 'WebSite',
    '@id': `${siteConfig.metadataOrigin}/#website`,
    url: siteConfig.metadataOrigin,
    name: 'AliasMode',
    description: resolvedDescription,
    publisher: { '@id': organizationId },
  });
}
if (route && (route.kind === 'product' || route.kind === 'home')) {
  schemas.push({
    '@type': 'SoftwareApplication',
    name: 'AliasMode',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows',
    url: metadataUrl,
    description: resolvedDescription,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': organizationId },
  });
}
if (route && ['documentation', 'comparison', 'integration', 'use-case', 'guide', 'article'].includes(route.kind)) {
  schemas.push({
    '@type': route.kind === 'documentation' ? 'TechArticle' : 'Article',
    headline: resolvedTitle,
    description: resolvedDescription,
    url: metadataUrl,
    dateModified: '2026-08-10',
    author: { '@id': organizationId },
    publisher: { '@id': organizationId },
  });
}
if (breadcrumbs.length > 1) {
  schemas.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.path, siteConfig.metadataOrigin).toString(),
    })),
  });
}
const structuredData = schemas.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemas }).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={resolvedDescription} />
    <meta property="og:site_name" content="AliasMode" />
    <meta property="og:type" content={route?.kind === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={metadataUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AliasMode: free, open-source antidetect browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..900&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!shouldIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {siteConfig.googleSiteVerification && !noIndex && <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />}
    {siteConfig.bingSiteVerification && !noIndex && <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#2457D6" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/></svg>AliasMode <span>by Xreacher</span></a>
      <nav class="main-nav" aria-label="Main navigation"><a href="/product/">Product</a><a href="/agencies/">Agencies</a><a href="/docs/">Docs</a><a href="/alternatives/">Alternatives</a><a href="/pricing/">Pricing</a></nav>
      <a class="header-cta" href="/download/">Download free</a>
    </header>
    <main>
      {route && <Breadcrumbs route={route} />}
      <slot />
    </main>
    <footer>
      <div class="footer-brand"><strong>AliasMode</strong><span>Free, open-source multi-account browsing.</span><GitHubButton href={siteConfig.githubRepository} label="GitHub" compact /></div>
      <nav aria-label="Product navigation"><strong>Product</strong><a href="/download/">Download</a><a href="/local/">Local</a><a href="/cloud/">Cloud</a><a href="/security/">Security</a></nav>
      <nav aria-label="Resource navigation"><strong>Resources</strong><a href="/docs/">Documentation</a><a href="/integrations/">Integrations</a><a href="/guides/">Guides</a><a href="/tools/">Tools</a></nav>
      <nav aria-label="Company and legal navigation"><strong>Company</strong><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/terms/">Terms</a><a href="/privacy/">Privacy</a><a href="/acceptable-use/">Acceptable Use</a></nav>
    </footer>
    {siteConfig.analyticsEndpoint && !noIndex && (
      <script is:inline define:vars={{ endpoint: siteConfig.analyticsEndpoint }}>
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('[data-track-cta]');
          if (!(link instanceof HTMLElement)) return;
          const body = JSON.stringify({
            pageGroup: link.dataset.pageGroup,
            ctaType: link.dataset.ctaType,
            destination: link.dataset.destination,
            campaign: link.dataset.campaign || undefined,
          });
          navigator.sendBeacon(endpoint, new Blob([body], { type: 'application/json' }));
        });
      </script>
    )}
  </body>
</html>
<style is:global>
  :root {
    color: #16202f;
    background: #f6f8fc;
    font-family: "Inter", Aptos, "Segoe UI", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-feature-settings: "cv11", "ss01";
    line-height: 1.55;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgba(36, 87, 214, .07), transparent 60%),
      radial-gradient(50rem 28rem at -10% 0%, rgba(49, 184, 199, .06), transparent 55%),
      #f6f8fc;
    margin: 0;
    overflow-x: hidden;
  }
  ::selection { background: rgba(36, 87, 214, .18); }
  [id] { scroll-margin-top: 6rem; }
  a { color: inherit; text-underline-offset: .18em; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #31b8c7; outline-offset: 3px; }
  .site-header, footer, main { margin: auto; max-width: 72rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  .site-header { align-items: center; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); background: rgba(246, 248, 252, .82); border-bottom: 1px solid rgba(219, 227, 238, .7); display: grid; gap: 1.5rem; grid-template-columns: auto 1fr auto; margin-top: 0; max-width: none; min-height: 5.25rem; padding-left: max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)); padding-right: max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)); position: sticky; top: 0; z-index: 50; }
  .main-nav { justify-content: center; }
  nav { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .88rem; }
  nav a { color: #46556d; font-weight: 600; text-decoration: none; transition: color .15s ease; }
  nav a:hover { color: #2457d6; }
  .brand { align-items: center; color: #111827; display: inline-flex; font-size: 1.1rem; font-weight: 800; gap: .5rem; letter-spacing: -.025em; text-decoration: none; white-space: nowrap; }
  .brand-mark { height: 1.65rem; width: 1.65rem; }
  .brand span { color: #64748b; font-size: .75rem; font-weight: 550; }
  .header-cta { background: #2457d6; border-radius: .5rem; box-shadow: 0 .35rem .9rem rgba(36, 87, 214, .25); color: white; font-size: .8rem; font-weight: 750; padding: .6rem .9rem; text-decoration: none; transition: background .15s ease, box-shadow .15s ease, transform .15s ease; white-space: nowrap; }
  .header-cta:hover { background: #1b46b4; box-shadow: 0 .5rem 1.2rem rgba(36, 87, 214, .3); transform: translateY(-1px); }
  main { min-height: calc(100vh - 14rem); padding-bottom: 5rem; padding-top: 3.5rem; }
  footer { align-items: flex-start; background: #fff; border-top: 1px solid #e2e8f2; color: #526077; display: grid; font-size: .8rem; gap: 2rem; grid-template-columns: 1.4fr repeat(3, 1fr); max-width: none; min-height: 8.5rem; padding: 2.5rem max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)); }
  footer nav { align-items: flex-start; flex-direction: column; gap: .5rem; }
  footer nav strong { color: #172033; font-size: .74rem; letter-spacing: .07em; margin-bottom: .2rem; text-transform: uppercase; }
  .footer-brand { align-items: flex-start; display: flex; flex-direction: column; gap: .45rem; }
  .footer-brand strong { color: #172033; font-size: .95rem; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.8rem); letter-spacing: -.058em; line-height: .98; margin: 0 0 1.25rem; max-width: 13ch; text-wrap: balance; }
  h2 { font-size: 1.5rem; letter-spacing: -.04em; line-height: 1.08; margin: 0 0 .7rem; text-wrap: balance; }
  h3 { letter-spacing: -.02em; margin-bottom: .25rem; }
  p { max-width: 68ch; }
  .eyebrow { color: #2b63e8; font: 700 .72rem/1.2 "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .11em; text-transform: uppercase; }
  .lead { color: #3e4d65; font-size: 1.15rem; max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.7rem 0; }
  .button { background: linear-gradient(180deg, #2b63e8, #2457d6); border: 1px solid #2457d6; border-radius: .55rem; box-shadow: 0 .5rem 1.3rem rgba(36, 87, 214, .24), inset 0 1px 0 rgba(255, 255, 255, .18); color: #fff; display: inline-block; font-size: .9rem; font-weight: 750; padding: .78rem 1.1rem; text-decoration: none; transition: box-shadow .18s ease, transform .18s ease, filter .18s ease; }
  .button:hover { box-shadow: 0 .7rem 1.6rem rgba(36, 87, 214, .3), inset 0 1px 0 rgba(255, 255, 255, .18); filter: brightness(1.06); transform: translateY(-1px); }
  .button:active { transform: translateY(0); }
  .button.secondary { background: #fff; border-color: #cbd7e7; box-shadow: 0 .2rem .6rem rgba(23, 45, 84, .06); color: #1b46b4; }
  .button.secondary:hover { background: #f2f6ff; border-color: #a9bce4; filter: none; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 2.5rem 0; }
  .card, .notice { background: #fff; border: 1px solid #e2e8f2; border-radius: .8rem; box-shadow: 0 .25rem .8rem rgba(23, 45, 84, .05); padding: 1.4rem; }
  .notice { border-left: .3rem solid #e0a630; }
  .muted { color: #526077; }
  code { background: #edf2f8; border-radius: .25rem; font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .92em; padding: .12rem .3rem; word-break: break-word; }
  pre { background: #0f1622; border: 1px solid #1f2c42; border-radius: .7rem; color: #e9eff9; max-width: 100%; overflow-x: auto; padding: 1.25rem; }
  pre code { background: transparent; color: inherit; padding: 0; white-space: pre; }
  table { border-collapse: collapse; min-width: 42rem; width: 100%; }
  th, td { border-bottom: 1px solid #dbe3ee; padding: .85rem; text-align: left; vertical-align: top; }
  th { background: #edf3ff; color: #26344a; font-size: .78rem; letter-spacing: .035em; text-transform: uppercase; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  ul, ol { max-width: 68ch; padding-left: 1.2rem; }
  li + li { margin-top: .5rem; }
  .legal h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .content-body { display: grid; gap: 3.5rem; margin-top: 3.5rem; }
  .content-section { display: grid; gap: .65rem; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1.35fr); }
  .content-section > div > :first-child, .content-section > :first-child { margin-top: 0; }
  .content-section h2 { font-size: clamp(1.8rem, 3vw, 2.7rem); }
  .content-section-copy > *:first-child { margin-top: 0; }
  .content-section-copy > *:last-child { margin-bottom: 0; }
  .fact-strip { display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); margin: 2rem 0; }
  .fact-strip > div { background: linear-gradient(180deg, #eef3ff, #e8efff); padding: 1.2rem; }
  .fact-strip > div:first-child { border-radius: .7rem 0 0 .7rem; }
  .fact-strip > div:last-child { border-radius: 0 .7rem .7rem 0; }
  .fact-strip strong { color: #1b46b4; display: block; font-size: 1.35rem; letter-spacing: -.02em; }
  .fact-strip span { color: #526077; font-size: .8rem; }
  .callout { background: #eaf0ff; border-left: .3rem solid #2457d6; margin: 2rem 0; padding: 1.2rem 1.4rem; }
  .source-list { color: #526077; font-size: .84rem; }
  @media (max-width: 60rem) {
    .main-nav { gap: .75rem; }
    footer { grid-template-columns: repeat(3, 1fr); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 54rem) {
    .site-header { gap: .8rem; grid-template-columns: 1fr auto; padding-bottom: 1rem; padding-top: 1rem; }
    .main-nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; order: 3; }
    .content-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    .brand span { display: none; }
    .main-nav { gap: .75rem 1rem; }
    main { padding-top: 2rem; }
    footer { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .button { transition: none; }
  }
</style>
