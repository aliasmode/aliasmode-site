---
import ComparisonPageLayout from '../layouts/ComparisonPage.astro';
import DocsPageLayout from '../layouts/DocsPage.astro';
import HubPageLayout from '../layouts/HubPage.astro';
import IntegrationPageLayout from '../layouts/IntegrationPage.astro';
import RankingPageLayout from '../layouts/RankingPage.astro';
import TaskGuidePageLayout from '../layouts/TaskGuidePage.astro';
import { contentPages, getContentPage } from '../data/content-index';
import { canonicalPath } from '../data/paths';

export function getStaticPaths() {
  return contentPages.map((page) => ({
    params: { slug: page.path.replace(/^\//, '').replace(/\/$/, '') },
    props: { path: page.path },
  }));
}

const { path } = Astro.props as { path: string };
const page = getContentPage(path);
if (!page) throw new Error(`No content record renders ${canonicalPath(path)}`);
---
{page.family === 'comparison' && <ComparisonPageLayout page={page} />}
{page.family === 'ranking' && <RankingPageLayout page={page} />}
{page.family === 'task-guide' && <TaskGuidePageLayout page={page} />}
{page.family === 'docs' && <DocsPageLayout page={page} />}
{page.family === 'integration' && <IntegrationPageLayout page={page} />}
{page.family === 'hub' && <HubPageLayout page={page} />}
