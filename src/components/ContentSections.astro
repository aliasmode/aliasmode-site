---
import type { SeoSection } from '../data/seo-pages';

interface Props { sections: SeoSection[] }
const { sections } = Astro.props;
---
<div class="content-body">
  {sections.map((section: SeoSection) => (
    <section class="content-section">
      <div><h2>{section.title}</h2></div>
      <div class="content-section-copy">
        {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((item: string) => <li>{item}</li>)}</ul>}
        {section.code && <pre><code>{section.code}</code></pre>}
        {section.links && <div class="section-links">{section.links.map((link: { href: string; label: string }) => <a href={link.href}>{link.label} →</a>)}</div>}
      </div>
    </section>
  ))}
</div>

<style>
  .section-links { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-top: 1.3rem; }
  .section-links a { color: var(--violet-deep); font-weight: 700; }
</style>
