---
import { getSiteRoute } from '../data/site-routes';
import type { SiteRoute } from '../data/site-routes';

interface Props { paths: string[] }
const { paths } = Astro.props;
const routes = paths.map(getSiteRoute).filter(Boolean);
---
<div class="hub-grid">
  {routes.map((route: SiteRoute | undefined) => route && (
    <a href={route.path}>
      <span class="kind">{route.kind}</span>
      <strong>{route.label}</strong>
      <p>{route.description}</p>
      <span class="open">Open →</span>
    </a>
  ))}
</div>

<style>
  .hub-grid { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); margin: 3rem 0; }
  .hub-grid a { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r-md); display: flex; flex-direction: column; min-height: 14rem; padding: 1.6rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .hub-grid a:hover { border-color: var(--violet-line); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .hub-grid .kind { color: var(--violet); font: 700 .66rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .hub-grid strong { color: var(--ink); font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -.03em; line-height: 1.15; margin-top: 1.1rem; }
  .hub-grid p { color: var(--ink-2); font-size: .89rem; }
  .hub-grid .open { color: var(--violet-deep); font-size: .84rem; font-weight: 700; margin-top: auto; padding-top: 1.2rem; }
  @media (prefers-reduced-motion: reduce) { .hub-grid a { transition: none; } }
</style>
