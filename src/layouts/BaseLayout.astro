---
import { siteConfig } from '../../site.config.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GitHubButton from '../components/GitHubButton.astro';
import { canonicalPath, getBreadcrumbs, getSiteRoute } from '../data/site-routes';

interface Props { title?: string; description?: string; noIndex?: boolean; canonical?: boolean }
const {
  title = 'Free Open-Source Antidetect Browser',
  description = 'AliasMode is a free, open-source antidetect browser for managing multiple accounts.',
  noIndex = false,
  canonical: includeCanonical = true,
} = Astro.props;
const route = getSiteRoute(Astro.url.pathname);
const routePath = route?.path ?? canonicalPath(Astro.url.pathname);
const resolvedTitle = route?.title ?? title;
const resolvedDescription = route?.description ?? description;
const fullTitle = `${resolvedTitle} · AliasMode`;
const shouldIndex = siteConfig.index && !noIndex;
const canonical = shouldIndex && includeCanonical ? new URL(routePath, siteConfig.origin).toString() : undefined;
const metadataUrl = new URL(routePath, siteConfig.metadataOrigin).toString();
const socialImage = new URL('/social/aliasmode-open-source-antidetect-browser.png', siteConfig.metadataOrigin).toString();
const breadcrumbs = route ? getBreadcrumbs(route) : [];
const organizationId = `${siteConfig.metadataOrigin}/#organization`;
const schemas: Record<string, unknown>[] = [];

if (route) {
  schemas.push({
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Xreacher',
    url: 'https://xreacher.com/',
    brand: { '@type': 'Brand', name: 'AliasMode', url: siteConfig.metadataOrigin },
  });
}
if (route?.kind === 'home') {
  schemas.push({
    '@type': 'WebSite',
    '@id': `${siteConfig.metadataOrigin}/#website`,
    url: siteConfig.metadataOrigin,
    name: 'AliasMode',
    description: resolvedDescription,
    publisher: { '@id': organizationId },
  });
}
if (route && (route.kind === 'product' || route.kind === 'home')) {
  schemas.push({
    '@type': 'SoftwareApplication',
    name: 'AliasMode',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows',
    url: metadataUrl,
    description: resolvedDescription,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': organizationId },
  });
}
if (route && ['documentation', 'comparison', 'integration', 'use-case', 'guide', 'article'].includes(route.kind)) {
  schemas.push({
    '@type': route.kind === 'documentation' ? 'TechArticle' : 'Article',
    headline: resolvedTitle,
    description: resolvedDescription,
    url: metadataUrl,
    dateModified: '2026-08-10',
    author: { '@id': organizationId },
    publisher: { '@id': organizationId },
  });
}
if (breadcrumbs.length > 1) {
  schemas.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: new URL(crumb.path, siteConfig.metadataOrigin).toString(),
    })),
  });
}
const structuredData = schemas.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemas }).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={resolvedDescription} />
    <meta property="og:site_name" content="AliasMode" />
    <meta property="og:type" content={route?.kind === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={metadataUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AliasMode — free, open-source antidetect browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!shouldIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {siteConfig.googleSiteVerification && !noIndex && <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />}
    {siteConfig.bingSiteVerification && !noIndex && <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#2457D6" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/></svg>AliasMode <span>by Xreacher</span></a>
      <nav class="main-nav" aria-label="Main navigation"><a href="/product/">Product</a><a href="/agencies/">Agencies</a><a href="/docs/">Docs</a><a href="/alternatives/">Alternatives</a><a href="/pricing/">Pricing</a></nav>
      <a class="header-cta" href="/download/">Download free</a>
    </header>
    <main>
      {route && <Breadcrumbs route={route} />}
      <slot />
    </main>
    <footer>
      <div class="footer-brand"><strong>AliasMode</strong><span>Free, open-source multi-account browsing.</span><GitHubButton href={siteConfig.githubRepository} label="GitHub" compact /></div>
      <nav aria-label="Product navigation"><strong>Product</strong><a href="/download/">Download</a><a href="/local/">Local</a><a href="/cloud/">Cloud</a><a href="/security/">Security</a></nav>
      <nav aria-label="Resource navigation"><strong>Resources</strong><a href="/docs/">Documentation</a><a href="/integrations/">Integrations</a><a href="/guides/">Guides</a><a href="/tools/">Tools</a></nav>
      <nav aria-label="Company and legal navigation"><strong>Company</strong><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/terms/">Terms</a><a href="/privacy/">Privacy</a><a href="/acceptable-use/">Acceptable Use</a></nav>
    </footer>
    {siteConfig.analyticsEndpoint && !noIndex && (
      <script is:inline define:vars={{ endpoint: siteConfig.analyticsEndpoint }}>
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('[data-track-cta]');
          if (!(link instanceof HTMLElement)) return;
          const body = JSON.stringify({
            pageGroup: link.dataset.pageGroup,
            ctaType: link.dataset.ctaType,
            destination: link.dataset.destination,
            campaign: link.dataset.campaign || undefined,
          });
          navigator.sendBeacon(endpoint, new Blob([body], { type: 'application/json' }));
        });
      </script>
    )}
  </body>
</html>
<style is:global>
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  :root {
    color-scheme: dark;
    --bg: #04060b;
    --bg-soft: #070b14;
    --panel: #0a1020;
    --panel-2: #0d1526;
    --line: rgba(148, 163, 199, .13);
    --line-strong: rgba(148, 163, 199, .26);
    --ink: #e8eef9;
    --muted: #9dabc4;
    --faint: #68778f;
    --accent: #31b8c7;
    --accent-bright: #6ee7f2;
    --blue: #3d6bff;
    --blue-soft: #8ba7ff;
    --grad: linear-gradient(100deg, #8ba7ff, #31b8c7 55%, #6ee7f2);
    --font-display: 'Space Grotesk', 'Aptos Display', 'Segoe UI', ui-sans-serif, system-ui, sans-serif;
    --font-body: Aptos, 'Segoe UI', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-body);
    line-height: 1.55;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); margin: 0; overflow-x: hidden; }
  /* Ambient stage: faint grid + aurora glows behind everything */
  body::before {
    background-image: linear-gradient(rgba(139, 167, 255, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 167, 255, .05) 1px, transparent 1px);
    background-size: 3.4rem 3.4rem;
    content: '';
    inset: 0;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .9), transparent 70%);
    pointer-events: none;
    position: fixed;
    z-index: -2;
  }
  body::after {
    background:
      radial-gradient(42rem 26rem at 82% -8%, rgba(49, 184, 199, .15), transparent 62%),
      radial-gradient(46rem 30rem at 8% -12%, rgba(61, 107, 255, .17), transparent 60%);
    content: '';
    inset: 0;
    pointer-events: none;
    position: fixed;
    z-index: -3;
  }
  a { color: inherit; text-underline-offset: .18em; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  ::selection { background: rgba(49, 184, 199, .35); color: #fff; }
  .site-header, footer, main { margin: auto; max-width: 72rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  .site-header { align-items: center; display: grid; gap: 1.5rem; grid-template-columns: auto 1fr auto; min-height: 5.25rem; }
  .main-nav { justify-content: center; }
  nav { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .88rem; }
  nav a { color: var(--muted); font-weight: 600; text-decoration: none; transition: color .18s ease; }
  nav a:hover { color: var(--accent-bright); }
  .brand { align-items: center; color: var(--ink); display: inline-flex; font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; gap: .5rem; letter-spacing: -.025em; text-decoration: none; white-space: nowrap; }
  .brand-mark { height: 1.65rem; width: 1.65rem; }
  .brand span { color: var(--faint); font-size: .75rem; font-weight: 500; }
  .header-cta {
    background: var(--grad);
    border-radius: .55rem;
    box-shadow: 0 0 1.4rem rgba(49, 184, 199, .28);
    color: #041018;
    font-size: .8rem;
    font-weight: 800;
    padding: .62rem .95rem;
    text-decoration: none;
    transition: box-shadow .18s ease, transform .18s ease;
    white-space: nowrap;
  }
  .header-cta:hover { box-shadow: 0 0 2.2rem rgba(49, 184, 199, .45); transform: translateY(-1px); }
  main { min-height: calc(100vh - 14rem); padding-bottom: 5rem; padding-top: 3.5rem; }
  footer { align-items: flex-start; border-top: 1px solid var(--line); color: var(--muted); display: grid; font-size: .8rem; gap: 2rem; grid-template-columns: 1.4fr repeat(3, 1fr); min-height: 8.5rem; padding-bottom: 2.5rem; padding-top: 2.5rem; }
  footer nav { align-items: flex-start; flex-direction: column; gap: .5rem; }
  footer nav strong { color: var(--ink); font-family: var(--font-display); font-size: .74rem; letter-spacing: .07em; margin-bottom: .2rem; text-transform: uppercase; }
  .footer-brand { align-items: flex-start; display: flex; flex-direction: column; gap: .45rem; }
  .footer-brand strong { color: var(--ink); font-family: var(--font-display); font-size: .95rem; }
  h1, h2, h3 { font-family: var(--font-display); }
  h1 { font-size: clamp(2.4rem, 6vw, 4.8rem); font-weight: 700; letter-spacing: -.045em; line-height: .98; margin: 0 0 1.25rem; max-width: 13ch; text-wrap: balance; }
  h2 { font-size: 1.5rem; font-weight: 650; letter-spacing: -.03em; line-height: 1.08; margin: 0 0 .7rem; text-wrap: balance; }
  h3 { letter-spacing: -.015em; margin-bottom: .25rem; }
  p { max-width: 68ch; }
  .eyebrow { color: var(--accent); font: 700 .73rem/1.2 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .lead { color: var(--muted); font-size: 1.15rem; max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.7rem 0; }
  .button {
    background: var(--grad);
    border: 1px solid transparent;
    border-radius: .55rem;
    box-shadow: 0 0 1.6rem rgba(49, 184, 199, .22);
    color: #041018;
    display: inline-block;
    font-size: .9rem;
    font-weight: 800;
    padding: .78rem 1.1rem;
    text-decoration: none;
    transition: box-shadow .18s ease, transform .18s ease;
  }
  .button:hover { box-shadow: 0 0 2.6rem rgba(49, 184, 199, .45); transform: translateY(-1px); }
  .button.secondary { background: rgba(139, 167, 255, .06); border-color: var(--line-strong); box-shadow: none; color: var(--ink); }
  .button.secondary:hover { border-color: var(--accent); box-shadow: 0 0 1.4rem rgba(49, 184, 199, .18); }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 2.5rem 0; }
  .card, .notice { background: linear-gradient(180deg, rgba(139, 167, 255, .05), rgba(139, 167, 255, .015)); border: 1px solid var(--line); border-radius: .8rem; padding: 1.4rem; }
  .notice { border-left: .3rem solid #e0a630; }
  .muted { color: var(--muted); }
  code { background: rgba(139, 167, 255, .1); border-radius: .2rem; padding: .1rem .25rem; word-break: break-word; }
  pre { background: #060a13; border: 1px solid var(--line); color: #dbe6f7; max-width: 100%; overflow-x: auto; padding: 1.25rem; }
  pre code { background: transparent; color: inherit; padding: 0; white-space: pre; }
  table { border-collapse: collapse; min-width: 42rem; width: 100%; }
  th, td { border-bottom: 1px solid var(--line); padding: .85rem; text-align: left; vertical-align: top; }
  th { background: rgba(139, 167, 255, .07); color: var(--muted); font-size: .78rem; letter-spacing: .05em; text-transform: uppercase; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  ul, ol { max-width: 68ch; padding-left: 1.2rem; }
  li + li { margin-top: .5rem; }
  .legal h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .content-body { display: grid; gap: 3.5rem; margin-top: 3.5rem; }
  .content-section { border-top: 1px solid var(--line); display: grid; gap: .65rem; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1.35fr); padding-top: 2.5rem; }
  .content-section > div > :first-child, .content-section > :first-child { margin-top: 0; }
  .content-section h2 { font-size: clamp(1.8rem, 3vw, 2.7rem); }
  .content-section-copy { color: var(--muted); }
  .content-section-copy > *:first-child { margin-top: 0; }
  .content-section-copy > *:last-child { margin-bottom: 0; }
  .fact-strip { display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); margin: 2rem 0; }
  .fact-strip > div { background: linear-gradient(180deg, rgba(49, 184, 199, .07), rgba(61, 107, 255, .05)); border: 1px solid var(--line); padding: 1.2rem; }
  .fact-strip strong { display: block; font-family: var(--font-display); font-size: 1.25rem; }
  .fact-strip span { color: var(--muted); }
  .callout { background: rgba(61, 107, 255, .08); border-left: .3rem solid var(--accent); margin: 2rem 0; padding: 1.2rem 1.4rem; }
  .source-list { color: var(--muted); font-size: .84rem; }
  @media (max-width: 60rem) {
    .main-nav { gap: .75rem; }
    footer { grid-template-columns: repeat(3, 1fr); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 54rem) {
    .site-header { gap: .8rem; grid-template-columns: 1fr auto; padding-bottom: 1rem; padding-top: 1rem; }
    .main-nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; order: 3; }
    .content-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    .brand span { display: none; }
    .main-nav { gap: .75rem 1rem; }
    main { padding-top: 2rem; }
    footer { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .button, .header-cta { transition: none; }
  }
</style>