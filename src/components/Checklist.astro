---
/** Check-marked list. `box` tone reads as things to have ready; `check` as things to confirm. */
interface Props { items: string[]; tone?: 'check' | 'box' }
const { items, tone = 'check' } = Astro.props;
---
<ul class:list={['checklist', tone]}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .checklist { display: grid; gap: .55rem; list-style: none; margin: 1.2rem 0 0; max-width: none; padding: 0; }
  .checklist li { margin: 0; padding-left: 2rem; position: relative; }
  .checklist li::before { align-items: center; border-radius: .4rem; content: ''; display: flex; font-size: .68rem; font-weight: 900; height: 1.3rem; justify-content: center; left: 0; position: absolute; top: .1rem; width: 1.3rem; }
  .checklist.check li::before { background: var(--pass-soft); color: var(--pass); content: '\2713'; }
  .checklist.box li::before { background: var(--violet-soft); box-shadow: inset 0 0 0 1px var(--violet-line); }
</style>
