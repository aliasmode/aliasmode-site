---
/** Terminal-style code card, matching the homepage `.terminal` treatment. */
interface Props { code: string; title?: string; language?: string }
const { code, title, language } = Astro.props;
const label = title ?? language ?? 'code';
---
<div class="code-card" data-language={language}>
  <div class="code-bar" aria-hidden="true"><span></span><span></span><span></span><b>{label}</b></div>
  <pre><code>{code}</code></pre>
</div>

<style>
  .code-card { background: linear-gradient(152deg, var(--night), #241d47); border: 1px solid var(--night-line); border-radius: var(--r-md); box-shadow: 0 1.2rem 2.4rem -1.2rem rgba(46, 27, 122, .4); margin: 1.4rem 0; max-width: 100%; overflow: hidden; }
  .code-bar { align-items: center; border-bottom: 1px solid var(--night-line); display: flex; gap: .4rem; padding: .7rem .9rem; }
  .code-bar span { background: var(--night-3); border-radius: 50%; height: .48rem; width: .48rem; }
  .code-bar span:first-child { background: var(--violet); }
  .code-bar b { color: var(--night-ink-2); font: 600 .66rem/1 var(--font-mono); margin-left: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .code-card pre { background: none; border: 0; border-radius: 0; margin: 0; overflow-x: auto; padding: clamp(1rem, 2.5vw, 1.4rem) clamp(1rem, 3vw, 1.5rem); }
  .code-card code { background: transparent; color: #ded6f8; font-size: clamp(.72rem, 1.2vw, .82rem); line-height: 1.8; padding: 0; white-space: pre; word-break: normal; }
</style>
