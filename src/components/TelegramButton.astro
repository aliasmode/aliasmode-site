---
interface Props {
  href: string;
  label: string;
  tone?: 'telegram' | 'outline' | 'light';
  compact?: boolean;
  iconOnly?: boolean;
}

const { href, label, tone = 'telegram', compact = false, iconOnly = false } = Astro.props;
---
<a class:list={['telegram-button', tone, { compact, 'icon-only': iconOnly }]} href={href} rel="noopener" aria-label={iconOnly ? label : undefined}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42Z"/></svg>
  {!iconOnly && <span>{label}</span>}
</a>

<style>
  .telegram-button { align-items: center; border-radius: var(--r-pill); display: inline-flex; font-size: .9rem; font-weight: 700; gap: .55rem; justify-content: center; padding: .85rem 1.4rem; text-decoration: none; transition: background .18s ease, box-shadow .18s ease, color .18s ease, transform .18s ease; }
  .telegram-button svg { flex: 0 0 auto; height: 1.15rem; width: 1.15rem; }
  .telegram-button.telegram { background: linear-gradient(175deg, #38b6ee, #229ed9); box-shadow: 0 .7rem 1.6rem -.7rem rgba(34, 158, 217, .7); color: #fff; }
  .telegram-button.telegram:hover { filter: brightness(1.07); transform: translateY(-1px); }
  .telegram-button.outline { background: var(--panel); box-shadow: inset 0 0 0 1px var(--violet-line), var(--shadow-sm); color: var(--ink); }
  .telegram-button.outline:hover { background: var(--violet-soft); box-shadow: inset 0 0 0 1px var(--violet); transform: translateY(-1px); }
  .telegram-button.light { background: #fff; color: var(--ink); }
  .telegram-button.light:hover { background: var(--violet-soft); transform: translateY(-1px); }
  .telegram-button.compact { font-size: .78rem; padding: .5rem .9rem; }
  .telegram-button.compact svg { height: 1rem; width: 1rem; }
  /* Header variant: a round glyph that keeps the pill compact. */
  .telegram-button.icon-only { padding: .5rem; }
  .telegram-button.icon-only svg { height: 1.25rem; width: 1.25rem; }
  .telegram-button.icon-only.outline { box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); }
  .telegram-button.icon-only.outline:hover { background: #e8f6fd; box-shadow: inset 0 0 0 1px #a8ddf5; color: #17769f; }
  .telegram-button:focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .telegram-button { transition: none; } }
</style>
