---
interface Props {
  href: string;
  label: string;
  tone?: 'dark' | 'outline' | 'light';
  compact?: boolean;
}

const { href, label, tone = 'dark', compact = false } = Astro.props;
---
<a class:list={['github-button', tone, { compact }]} href={href}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.41-1.27.74-1.56-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.47.11-3.06 0 0 .98-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.18-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.06.75.81 1.2 1.84 1.2 3.1 0 4.41-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
  <span>{label}</span>
</a>

<style>
  .github-button { align-items: center; border: 1px solid #111827; border-radius: .48rem; display: inline-flex; font-size: .88rem; font-weight: 750; gap: .55rem; justify-content: center; padding: .72rem 1rem; text-decoration: none; transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease; }
  .github-button svg { flex: 0 0 auto; height: 1.15rem; width: 1.15rem; }
  .github-button.dark { background: #111827; color: white; }
  .github-button.dark:hover { background: #263247; border-color: #263247; transform: translateY(-1px); }
  .github-button.outline { background: white; color: #111827; }
  .github-button.outline:hover { background: #edf3f7; transform: translateY(-1px); }
  .github-button.light { background: white; border-color: white; color: #111827; }
  .github-button.light:hover { background: #e9eef5; border-color: #e9eef5; transform: translateY(-1px); }
  .github-button.compact { font-size: .78rem; padding: .45rem .65rem; }
  .github-button.compact svg { height: 1rem; width: 1rem; }
  @media (prefers-reduced-motion: reduce) { .github-button { transition: none; } }
</style>
