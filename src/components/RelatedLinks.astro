---
import { getSiteRoute } from '../data/site-routes';
import type { SiteRoute } from '../data/site-routes';

interface Props { paths: string[]; title?: string }
const { paths, title = 'Continue with AliasMode' } = Astro.props;
const routes = paths.map(getSiteRoute).filter(Boolean);
---
{routes.length > 0 && (
  <aside class="related" aria-labelledby="related-title">
    <p class="eyebrow">Related</p>
    <h2 id="related-title">{title}</h2>
    <div class="related-grid">
      {routes.map((route: SiteRoute | undefined) => route && (
        <a href={route.path}>
          <strong>{route.label}</strong>
          <span>{route.description}</span>
          <span class="arrow" aria-hidden="true">Read next →</span>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .related { border-top: 1px solid var(--line); margin-top: 5rem; padding-top: 3rem; }
  .related h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .related-grid { display: grid; gap: .85rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-top: 1.5rem; }
  .related-grid a { background: linear-gradient(180deg, rgba(139, 167, 255, .05), rgba(139, 167, 255, .015)); border: 1px solid var(--line); border-radius: .8rem; display: flex; flex-direction: column; gap: .5rem; min-height: 12rem; padding: 1.35rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .related-grid a:hover { border-color: var(--accent); box-shadow: 0 0 2rem rgba(49, 184, 199, .12); transform: translateY(-3px); }
  .related-grid strong { color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .related-grid span { color: var(--muted); font-size: .88rem; }
  .related-grid .arrow { color: var(--accent-bright); font-weight: 700; margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .related-grid a { transition: none; } }
</style>
