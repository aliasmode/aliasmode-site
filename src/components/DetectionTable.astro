---
import { detectionBaselineExplain, detectionBaselineShort, detectionBrowserVersion, detectionLastTested, detectionResults } from '../data/detection-results';
import type { DetectionResult } from '../data/detection-results';

interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
}

const {
  eyebrow = 'Detection test results',
  heading = 'Tested against live bot-detection services.',
  lead = 'Every AliasMode profile opens in CloakBrowser, a Chrome-based runtime patched at the source, so websites see a normal human-driven browser, not an automation tool. Here is how it compares on the public detection services that platforms use to screen visitors.',
} = Astro.props;

const isTechnical = (check: string) => /^(navigator\.|window\.|UA string|CDP|TLS)/.test(check);
---

<section class="detection-results" id="detection-results">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{heading}</h2>
  <p class="detection-lead">{lead}</p>
  <p class="detection-meta">All tests verified against live detection services. Last tested: <strong>{detectionLastTested}</strong> ({detectionBrowserVersion}).</p>

  <div class="table-scroll detection-table">
    <table>
      <thead>
        <tr>
          <th>Detection service</th>
          <th class="col-standard">{detectionBaselineShort}</th>
          <th class="col-cloak">CloakBrowser</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        {detectionResults.map((row: DetectionResult) => (
          <tr>
            <th scope="row">{isTechnical(row.check) ? <code>{row.check}</code> : row.check}</th>
            <td><span class="chip chip-fail">{row.standard}</span></td>
            <td><span class="chip chip-pass">{row.cloak}</span></td>
            <td class="result-note">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="detection-baseline">{detectionBaselineExplain}</p>
  <p class="detection-disclaimer">
    Point-in-time results from independent public test services; you can reproduce them yourself against a
    CloakBrowser profile. Detection vendors update their checks continuously, and no browser can guarantee a pass on
    every service forever.
  </p>
</section>

<style>
  .detection-results { margin: 4.5rem 0; scroll-margin-top: 2rem; }
  .detection-results h2 { font-size: clamp(1.8rem, 3.4vw, 2.8rem); max-width: 22ch; }
  .detection-lead { color: var(--ink-2); font-size: 1.05rem; max-width: 72ch; }
  .detection-meta { color: var(--ink); font-size: .85rem; margin: 1.25rem 0 1.5rem; }
  .detection-table { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-md); overflow-x: auto; }
  .detection-table table { min-width: 44rem; }
  .detection-table tbody tr:last-child th, .detection-table tbody tr:last-child td { border-bottom: 0; }
  .detection-table tbody tr { transition: background .12s ease; }
  .detection-table tbody tr:hover { background: var(--panel-2); }
  .detection-table tbody tr:hover th[scope="row"] { background: var(--violet-soft); }
  .detection-table th[scope="row"] { background: var(--panel-2); color: var(--ink); font-family: var(--font-body); font-size: .88rem; font-weight: 700; letter-spacing: 0; text-transform: none; white-space: nowrap; }
  .detection-table th[scope="row"] code { background: transparent; color: var(--ink); padding: 0; }
  .detection-table td { min-width: 8rem; }
  .detection-table td.result-note { color: var(--ink-3); font-size: .8rem; min-width: 10rem; }
  .col-standard { background: #fdeee9; color: #8a3226; }
  .col-cloak { background: var(--signal-soft); color: #0a5f5a; }
  .chip { border-radius: var(--r-pill); display: inline-block; font-size: .78rem; font-weight: 700; padding: .3rem .7rem; white-space: nowrap; }
  .chip-fail { background: var(--fail-soft); color: var(--fail); }
  .chip-fail::before { content: '\2715\00a0'; font-size: .7em; }
  .chip-pass { background: var(--pass-soft); color: var(--pass); }
  .chip-pass::before { content: '\2713\00a0'; }
  .detection-baseline { color: var(--ink-2); font-size: .85rem; margin-top: 1.1rem; max-width: 75ch; }
  .detection-disclaimer { color: var(--ink-3); font-size: .8rem; margin-top: .5rem; max-width: 75ch; }
</style>
