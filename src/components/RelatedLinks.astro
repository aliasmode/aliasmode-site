---
import { requireSiteRoute } from '../data/site-routes';

interface Props { paths: string[]; title?: string }
const { paths, title = 'Continue with AliasMode' } = Astro.props;
const routes = paths.map((path) => requireSiteRoute(path, `${Astro.url.pathname} related links`));
---
{routes.length > 0 && (
  <aside class="related" aria-labelledby="related-title">
    <p class="eyebrow">Related</p>
    <h2 id="related-title">{title}</h2>
    <div class="related-grid">
      {routes.map((route) => (
        <a href={route.path}>
          <strong>{route.label}</strong>
          <span>{route.description}</span>
          <span class="arrow" aria-hidden="true">Read next →</span>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .related { border-top: 1px solid var(--line); margin-top: 5rem; padding-top: 3rem; }
  .related h2 { font-size: clamp(1.7rem, 2.8vw, 2.3rem); }
  .related-grid { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-top: 1.6rem; }
  .related-grid a { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r-md); display: flex; flex-direction: column; gap: .5rem; min-height: 11rem; padding: 1.4rem; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .related-grid a:hover { border-color: var(--violet-line); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .related-grid strong { color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.02em; }
  .related-grid span { color: var(--ink-2); font-size: .87rem; }
  .related-grid .arrow { color: var(--violet-deep); font-weight: 700; margin-top: auto; padding-top: 1rem; }
  @media (prefers-reduced-motion: reduce) { .related-grid a { transition: none; } }
</style>
