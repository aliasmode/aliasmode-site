---
import { siteConfig } from '../../site.config.mjs';

const donationHref = siteConfig.supportEmail
  ? `mailto:${siteConfig.supportEmail}?subject=AliasMode%20Donation`
  : '/contact/';
---
<section class="plans" aria-label="AliasMode plans">
  <div class="pricing-message"><strong>All AliasMode functionality is free.</strong><span>AliasMode is a non-profit project supported by optional donations.</span></div>
  <div class="pricing-grid">
    <article class="plan cloud-plan">
      <div class="plan-top"><div><p class="plan-label">Recommended</p><h3>Cloud</h3></div><span class="plan-badge">Free</span></div>
      <div class="price"><strong>$0</strong><span>Full product access</span></div>
      <p>Manage unlimited profiles, synchronize your work, and collaborate with your team.</p>
      <ul>
        <li>Unlimited browser profiles</li>
        <li>Isolated browser identities</li>
        <li>Encrypted portable-profile sync</li>
        <li>One workspace with owner/member roles</li>
        <li>Device revocation and trash</li>
      </ul>
      <a class="plan-button primary" href="/download/">Download &amp; sign up free</a>
    </article>

    <article class="plan local-plan">
      <div class="plan-top"><div><p class="plan-label">Account-free</p><h3>Local</h3></div><span class="plan-badge">Free</span></div>
      <div class="price"><strong>$0</strong><span>Unlimited local use</span></div>
      <p>Keep your browser profiles on one computer and work without an AliasMode account.</p>
      <ul>
        <li>Unlimited on-device profiles</li>
        <li>Isolated browser identities</li>
        <li>No account required</li>
        <li>No AliasMode Cloud traffic</li>
        <li>Open-source desktop app</li>
      </ul>
      <a class="plan-button secondary" href="/download/">Download Local</a>
    </article>

    <article class="plan donation-plan">
      <div class="plan-top"><div><p class="plan-label">Support the project</p><h3>Donate</h3></div></div>
      <div class="donation-price"><strong>Optional</strong><span>Help fund development</span></div>
      <p>AliasMode is a non-profit project. If it is useful to you, email us to discuss a donation.</p>
      <ul>
        <li>Support ongoing development</li>
        <li>Help cover project infrastructure</li>
        <li>Keep Cloud and Local free</li>
        <li>No feature gates or paid tiers</li>
        <li>Donate only if you want to</li>
      </ul>
      <a class="plan-button dark" href={donationHref}>Email us about donating</a>
    </article>
  </div>
</section>

<style>
  .plans { margin: 2rem 0 0; }
  .pricing-message { align-items: center; background: rgba(49, 184, 199, .08); border: 1px solid rgba(49, 184, 199, .3); border-radius: .8rem; display: flex; gap: .6rem 1.2rem; justify-content: center; margin-bottom: 1rem; padding: .9rem 1.2rem; text-align: center; }
  .pricing-message strong { color: var(--accent-bright); }
  .pricing-message span { color: var(--muted); font-size: .85rem; }
  .pricing-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .plan { background: linear-gradient(180deg, rgba(139, 167, 255, .05), rgba(139, 167, 255, .015)); border: 1px solid var(--line); border-radius: 1rem; display: flex; flex-direction: column; min-width: 0; padding: clamp(1.4rem, 2.6vw, 2rem); transition: border-color .18s ease, transform .18s ease; }
  .plan:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .cloud-plan { background: linear-gradient(160deg, rgba(61, 107, 255, .22), rgba(49, 184, 199, .14) 70%), var(--panel); border-color: rgba(110, 231, 242, .45); box-shadow: 0 0 3.5rem rgba(49, 184, 199, .16); position: relative; transform: translateY(-.5rem); }
  .cloud-plan:hover { border-color: var(--accent); transform: translateY(calc(-.5rem - 2px)); }
  .plan-top { align-items: flex-start; display: flex; gap: 1rem; justify-content: space-between; }
  .plan-label { color: var(--faint); font: 700 .65rem/1.2 var(--font-mono); letter-spacing: .1em; margin: 0 0 .35rem; text-transform: uppercase; }
  .cloud-plan .plan-label { color: var(--accent-bright); }
  .plan h3 { font-size: 1.65rem; margin: 0; }
  .plan-badge { background: rgba(110, 231, 242, .14); border: 1px solid rgba(110, 231, 242, .35); border-radius: 2rem; color: var(--accent-bright); font-size: .67rem; font-weight: 800; padding: .3rem .6rem; text-transform: uppercase; }
  .price { align-items: baseline; display: flex; flex-wrap: wrap; gap: .25rem .65rem; margin: 2rem 0 1rem; }
  .price strong { font-family: var(--font-display); font-size: 3.6rem; letter-spacing: -.06em; line-height: .8; }
  .price span, .donation-price span { color: var(--faint); font-size: .72rem; }
  .donation-price { display: flex; flex-direction: column; margin: 2rem 0 1rem; min-height: 3rem; }
  .donation-price strong { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: -.03em; }
  .plan > p { color: var(--muted); font-size: .85rem; min-height: 4.1rem; }
  .plan ul { flex: 1; list-style: none; margin: 1rem 0 1.6rem; padding: 0; }
  .plan li { color: var(--muted); font-size: .78rem; padding-left: 1.25rem; position: relative; }
  .plan li::before { color: var(--accent); content: '✓'; font-weight: 900; left: 0; position: absolute; }
  .cloud-plan li { color: var(--ink); }
  .plan li + li { margin-top: .55rem; }
  .plan-button { border: 1px solid var(--line-strong); border-radius: .55rem; display: block; font-size: .82rem; font-weight: 800; padding: .72rem .8rem; text-align: center; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease; }
  .plan-button.primary { background: var(--grad); border-color: transparent; box-shadow: 0 0 1.4rem rgba(49, 184, 199, .28); color: #041018; }
  .plan-button.primary:hover { box-shadow: 0 0 2.4rem rgba(49, 184, 199, .5); }
  .plan-button.secondary { background: rgba(139, 167, 255, .06); color: var(--ink); }
  .plan-button.secondary:hover { border-color: var(--accent); box-shadow: 0 0 1.2rem rgba(49, 184, 199, .18); }
  .plan-button.dark { background: transparent; color: var(--ink); }
  .plan-button.dark:hover { border-color: var(--accent); color: var(--accent-bright); }
  @media (prefers-reduced-motion: reduce) { .plan, .cloud-plan { transition: none; } }
  @media (max-width: 58rem) { .pricing-grid { grid-template-columns: 1fr; }.cloud-plan, .cloud-plan:hover { transform: none; }.plan > p { min-height: auto; }.pricing-message { align-items: flex-start; flex-direction: column; text-align: left; } }
</style>
