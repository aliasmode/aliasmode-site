---
import { siteConfig } from '../../site.config.mjs';

interface Props { title: string; description?: string; noIndex?: boolean; canonical?: boolean }
const { title, description = 'AliasMode helps you use browser profiles with a clear local or cloud choice.', noIndex = false, canonical: includeCanonical = true } = Astro.props;
const canonical = siteConfig.origin && includeCanonical ? new URL(Astro.url.pathname, siteConfig.origin).toString() : undefined;
const shouldIndex = siteConfig.index && !noIndex;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!shouldIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · AliasMode</title>
  </head>
  <body>
    <header><a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M152 96H320C380 96 416 136 416 196V316C416 376 376 416 316 416H196C136 416 96 376 96 316V288" stroke="currentColor" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/><path d="M96 288C96 240 136 208 184 208H280" stroke="#2457D6" stroke-width="64" stroke-linecap="round" stroke-linejoin="round"/></svg>AliasMode <span>by Xreacher</span></a><nav aria-label="Main navigation"><a href="/download">Download</a><a href="/local-vs-cloud">Local vs Cloud</a><a href="/security">Security</a><a href="/contact">Contact</a></nav></header>
    <main><slot /></main>
    <footer><div><strong>AliasMode</strong><span> Browser profiles, on your terms.</span></div><nav aria-label="Legal navigation"><a href="/terms">Terms</a><a href="/privacy">Privacy</a><a href="/acceptable-use">Acceptable Use</a></nav></footer>
  </body>
</html>
<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f8fafc; line-height: 1.55; }
  * { box-sizing: border-box; } body { margin: 0; } a { color: inherit; text-underline-offset: .18em; } header, footer, main { max-width: 72rem; margin: auto; padding-left: 1.5rem; padding-right: 1.5rem; } header { min-height: 5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; } nav { display: flex; flex-wrap: wrap; gap: 1rem; font-size: .92rem; } .brand { color: #111827; display: inline-flex; align-items: center; gap: .5rem; font-size: 1.1rem; font-weight: 750; text-decoration: none; letter-spacing: -.02em; } .brand-mark { width: 1.5rem; height: 1.5rem; } .brand span { color: #64748b; font-weight: 500; } main { min-height: calc(100vh - 11.5rem); padding-top: 3.5rem; padding-bottom: 5rem; } footer { border-top: 1px solid #dbe3ee; color: #526077; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 6.5rem; font-size: .88rem; } h1 { font-size: clamp(2.4rem, 6vw, 4.8rem); line-height: 1.02; letter-spacing: -.055em; margin: 0 0 1.25rem; max-width: 12ch; } h2 { font-size: 1.5rem; letter-spacing: -.03em; margin: 0 0 .6rem; } h3 { margin-bottom: .25rem; } p { max-width: 68ch; } .eyebrow { color: #536eae; font-size: .82rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; } .lead { color: #3e4d65; font-size: 1.15rem; max-width: 58ch; } .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.7rem 0; } .button { background: #214dcb; border-radius: .5rem; color: #fff; display: inline-block; font-weight: 700; padding: .7rem 1rem; text-decoration: none; } .button.secondary { background: #e8eefc; color: #173c9d; } .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; margin: 2.5rem 0; } .card, .notice { background: #fff; border: 1px solid #dbe3ee; border-radius: .75rem; padding: 1.25rem; } .notice { border-left: .3rem solid #e0a630; } .muted { color: #526077; } code { background: #edf2f8; border-radius: .2rem; padding: .1rem .25rem; word-break: break-all; } ul { max-width: 68ch; padding-left: 1.2rem; } li + li { margin-top: .5rem; } .legal h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); } @media (max-width: 42rem) { header, footer { align-items: flex-start; flex-direction: column; padding-top: 1.25rem; padding-bottom: 1.25rem; } main { padding-top: 2.5rem; } }
</style>
